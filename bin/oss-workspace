#!/bin/sh
# Open a maintainer session over the repository you are standing in.
#
# Clone a repo, run this, work. That is the whole promise, so everything it needs
# is either derived here or reported as missing — nothing is assumed to be set up.
#
# The working directory is the selection and is left exactly where the caller put
# it: this opens THEIR repo, not this plugin's checkout. The plugin root is
# resolved from the script's own location so a symlink into a bin directory works
# from anywhere:
#
#     ln -sf "$PWD/bin/oss-workspace" ~/.local/bin/oss-workspace
#
# Three things about the session are not the default, and each was measured
# against claude 2.1.219 rather than assumed:
#
#   * Without the development-channel flag, watch pollers still spawn and still
#     emit and nothing reads them — a board that looks armed and delivers
#     nothing. Check `supertool 'channel:health'` before trusting a green board.
#   * That flag resolves CONFIGURED MCP servers only, so the consumer is
#     registered at local scope here. Naming a server that is not registered
#     refuses the launch outright:
#         server:oss-channel - no MCP server configured with that name
#     So the flag is passed ONLY when the registration held AND no second
#     configured server also resolves to the same consumer script (#810,
#     below) -- two servers racing one Unix socket is worse than a session
#     with no board, the same reasoning that already governs registration.
#     A session with no channel is worth more than no session. #1307
#     changes what "the registration held" means: when an installed
#     plugin's own .mcp.json already declares a consumer for this repo,
#     oss-channel is never registered at all -- registering it on top would
#     BE the second server this same rule refuses to race. The flag is then
#     armed against the plugin's own server name instead.
#   * `claude` reads only its FIRST positional as the prompt, and a variadic
#     option swallows whatever follows it. The prompt therefore goes FIRST and
#     the flag LAST; putting the prompt after the flag ends the launch with
#         --dangerously-load-development-channels entries must be tagged: /oss:tick
#     which is exactly how this script failed on its first real use.
#
# Also not the default, added by #753 and #810 after the above was written:
# this file checks synchronously whether the oss plugin itself is current
# (self-review, #1392: it used to switch the opening prompt to /oss:doctor on
# a genuine update -- it no longer picks a prompt at all, and only still says
# the version moved) and repoints its own ~/.local/bin/oss-workspace pin if it
# is stale, and checks whether a SECOND configured MCP server races oss-channel
# for the same consumer script before arming the flag mentioned above. #1307
# adds a THIRD check, run before oss-channel's own registration rather than
# after it: whether an installed plugin already provides an in-scope
# consumer, in which case oss-channel is skipped entirely rather than
# registered and then raced.
set -eu

# A user's CDPATH can make `cd relative` land somewhere else entirely and print
# where it went. Cleared once here rather than prefixed onto each cd, which reads
# as a typo and is flagged as one.
CDPATH=

# --- fireworks. The first thing this launcher does, and the only thing it does for fun. ---
#
# Three rockets, three bursts, a shimmer, OSS in block letters, a cycle of spinner
# verbs, the tagline -- about three seconds, then the real work starts. Three
# guards, each a reason it must never get in the way: stdout has to be a terminal
# (a captured launch prints nothing decorative into a log), TERM must not be dumb,
# and OSS_WORKSPACE_NO_FIREWORKS set to anything skips it. A `sleep` that refuses
# a fractional argument -- strict POSIX sleep takes integers -- runs the frames
# back to back rather than failing the launch: nothing after this depends on it.
#
# Drawn on a 14-line canvas with relative cursor moves: `at ROW COL TEXT` moves
# down ROW and right COL from the canvas top, prints, and returns to the top. ROW
# is never 0 -- some terminals read `ESC[0B` as `ESC[1B`.
oss_fireworks() {
    [ -t 1 ] || return 0
    [ "${TERM:-dumb}" != "dumb" ] || return 0
    [ -z "${OSS_WORKSPACE_NO_FIREWORKS:-}" ] || return 0
    e=$(printf '\033')
    r="${e}[0m"; y="${e}[1;33m"; m="${e}[1;35m"; c="${e}[1;36m"; g="${e}[1;32m"; w="${e}[1;97m"; d="${e}[2m"; o="${e}[1;38;5;33m"
    H=14
    printf '\n\n\n\n\n\n\n\n\n\n\n\n\n\n'
    top() { printf '%s[%dA' "$e" "$H"; }
    clr() { top; i=0; while [ "$i" -lt "$H" ]; do printf '%-64s\n' ""; i=$((i+1)); done; top; }
    at() { printf '%s[%dB%s[%dC%s\r%s[%dA' "$e" "$1" "$e" "$2" "$3" "$e" "$1"; }
    z() { sleep "$1" 2>/dev/null || :; }
    burst() {
        # burst ROW COL COLOR STAGE -- stage 1 is the flash, 2 the ring, 3 the wide ring, 4 the fade
        R=$1; C=$2; K=$3
        case $4 in
        1) at "$R" "$C" "${w}*${r}" ;;
        2) at "$R" "$C" "${w}O${r}"; at "$((R-1))" "$C" "${K}|${r}"; at "$((R+1))" "$C" "${K}|${r}"
           at "$R" "$((C-2))" "${K}-${r}"; at "$R" "$((C+2))" "${K}-${r}"
           at "$((R-1))" "$((C-2))" "${K}\\${r}"; at "$((R-1))" "$((C+2))" "${K}/${r}"
           at "$((R+1))" "$((C-2))" "${K}/${r}"; at "$((R+1))" "$((C+2))" "${K}\\${r}" ;;
        3) at "$R" "$C" "${K}*${r}"
           at "$((R-2))" "$C" "${K}*${r}"; at "$((R+2))" "$C" "${K}*${r}"
           at "$R" "$((C-5))" "${K}*${r}"; at "$R" "$((C+5))" "${K}*${r}"
           at "$((R-2))" "$((C-4))" "${K}*${r}"; at "$((R-2))" "$((C+4))" "${K}*${r}"
           at "$((R+2))" "$((C-4))" "${K}*${r}"; at "$((R+2))" "$((C+4))" "${K}*${r}"
           at "$((R-1))" "$((C-2))" "${w}'${r}"; at "$((R-1))" "$((C+2))" "${w}'${r}"
           at "$((R+1))" "$((C-2))" "${w}.${r}"; at "$((R+1))" "$((C+2))" "${w}.${r}" ;;
        4) at "$((R-3))" "$C" "${d}.${r}"; at "$((R+3))" "$C" "${d}.${r}"
           at "$R" "$((C-7))" "${d}.${r}"; at "$R" "$((C+7))" "${d}.${r}"
           at "$((R-2))" "$((C-5))" "${d}.${r}"; at "$((R-2))" "$((C+5))" "${d}.${r}"
           at "$((R+2))" "$((C-5))" "${d}.${r}"; at "$((R+2))" "$((C+5))" "${d}.${r}"
           at "$((R-3))" "$((C-3))" "${d}.${r}"; at "$((R-3))" "$((C+3))" "${d}.${r}"
           at "$((R+3))" "$((C-3))" "${d}.${r}"; at "$((R+3))" "$((C+3))" "${d}.${r}" ;;
        esac
    }
    # three rockets climb, staggered
    clr; at 13 14 "${y}.${r}"; at 14 14 "${d}|${r}"; z 0.06
    clr; at 11 14 "${y}.${r}"; at 13 32 "${m}.${r}"; at 14 32 "${d}|${r}"; z 0.06
    clr; at  9 14 "${y}.${r}"; at 11 32 "${m}.${r}"; at 13 50 "${c}.${r}"; at 14 50 "${d}|${r}"; z 0.06
    clr; at  7 14 "${y}.${r}"; at  9 32 "${m}.${r}"; at 11 50 "${c}.${r}"; z 0.06
    clr; at  5 14 "${y}.${r}"; at  7 32 "${m}.${r}"; at  9 50 "${c}.${r}"; z 0.06
    # and burst, one after the other
    clr; burst 5 14 "$y" 1; at 5 32 "${m}.${r}"; at 7 50 "${c}.${r}"; z 0.07
    clr; burst 5 14 "$y" 2; burst 4 32 "$m" 1; at 5 50 "${c}.${r}"; z 0.08
    clr; burst 5 14 "$y" 3; burst 4 32 "$m" 2; burst 4 50 "$c" 1; z 0.09
    clr; burst 5 14 "$y" 4; burst 4 32 "$m" 3; burst 4 50 "$c" 2; z 0.09
    clr; burst 4 32 "$m" 4; burst 4 50 "$c" 3; z 0.09
    clr; burst 4 50 "$c" 4; z 0.10
    # the letters, with a last shimmer above them
    clr
    at 2  8 "${g}.${r}"; at 1 20 "${y}.${r}"; at 3 30 "${d}.${r}"; at 1 42 "${m}.${r}"; at 2 55 "${d}.${r}"; at 3 48 "${c}.${r}"
    at 5 18 "${o} ██████  ███████ ███████${r}"
    at 6 18 "${o}██    ██ ██      ██     ${r}"
    at 7 18 "${o}██    ██ ███████ ███████${r}"
    at 8 18 "${o}██    ██      ██      ██${r}"
    at 9 18 "${o} ██████  ███████ ███████${r}"
    z 0.18
    # leave the cursor just under the letters; the real steps print from here
    printf '%s[%dB\n' "$e" 10
    oss_steps=1
}
oss_fireworks

# --- the progression under the letters, and it is real: each line lands when its ---
# step actually finished, carrying what that step actually found. Three marks and
# they mean three different things -- a tick is a step that looked and passed, a
# question mark is one that could not look (never a pass), a dot is a decision
# not to do the step at all. A step that never printed is a step that never
# reported, and that renders as an absence a reader can see rather than a tick
# nobody earned. Silent when the fireworks were (no terminal, TERM=dumb, opted
# out): every line below is decoration over stderr prose that still prints as
# it always did, which is what the launcher tests read.
oss_step() {
    [ "${oss_steps:-0}" -eq 1 ] || return 0
    case $3 in
        ok)   mark="${g}✓${r}" ;;
        ask)  mark="${y}?${r}" ;;
        skip) mark="${d}·${r}" ;;
        go)   mark="${w}▸${r}" ;;
        *)    mark="${y}?${r}" ;;
    esac
    printf '  %s▸%s %-9s %-40s %s\n' "$d" "$r" "$1" "$2" "$mark"
}

CHANNEL_FLAG="--dangerously-load-development-channels"

# Deliberately not `claude-channel`: the supertool plugin's own entry keeps that
# name and keeps failing on an unset CLAUDE_PLUGIN_ROOT, and two servers sharing
# one name is a collision this script cannot decide the winner of.
CHANNEL_SERVER="oss-channel"

# `dirname "$0"` on a symlink gives the link's directory, not the checkout.
# `readlink -f` is not portable to macOS's stock readlink, so walk it.
#
# `entry_path` is `$0` BEFORE the walk below mutates `self` -- kept for #753's
# symlink-repoint block, further down: what may need repointing is the symlink
# this launcher was INVOKED through (typically ~/.local/bin/oss-workspace), and
# `self` after the walk is already wherever that symlink points, which cannot
# say whether the symlink itself is stale.
entry_path=$0
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *)  self=$(dirname "$self")/$link ;;
    esac
done
# `dirname` splits on `/` only. Under Git Bash `$0` arrives as
# `D:\a\repo\bin\oss-workspace`, so dirname answers `.` and the root resolves
# against the caller's directory instead — confidently, and wrongly. Strip either
# separator ourselves. The same shape failed the Windows leg in scripts/doctor.sh.
self_dir=${self%/*}
[ "$self_dir" = "$self" ] && self_dir=${self%\\*}
[ "$self_dir" = "$self" ] && self_dir=.
plugin_root=$(cd -- "$self_dir/.." && pwd -P)
export OSS_PLUGIN_ROOT="$plugin_root"

if ! command -v claude >/dev/null 2>&1; then
    echo "oss-workspace: claude is not on PATH, so there is no session to open." >&2
    exit 1
fi

if ! command -v git >/dev/null 2>&1; then
    echo "oss-workspace: git is not on PATH." >&2
    exit 1
fi

# The directory IS the selection. Opening a session over something that is not a
# repository would produce a board about nothing, so it is refused by name.
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "oss-workspace: $(pwd) is not a git work tree." >&2
    echo "  Stand in the repository you want to maintain and run this again." >&2
    exit 1
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# #1389/#1390/#1392: this launcher no longer picks the session's opening
# prompt. /oss:run asks "what does this repo need now" itself, from state and
# config -- probing and writing .oss.json on a fresh clone, diagnosing and
# repairing what is ours, and only then deciding whether to release, curate,
# triage or dispatch. A launcher-side guess in front of that would be a
# second copy of a decision the session already makes correctly.
prompt="/oss:run"

# `python3` by name is a POSIX assumption: Windows ships `python` and no
# `python3`, and its App Execution Alias makes a `python` that EXISTS and opens a
# store page instead of running. So each candidate is proved by running it and
# comparing a sentinel, the same route scripts/doctor.sh already takes.
python_bin=
for candidate in python3 python; do
    if [ "$("$candidate" -c "print(42)" 2>/dev/null)" = "42" ]; then
        python_bin=$candidate
        break
    fi
done
if [ -z "$python_bin" ]; then
    echo "oss-workspace: no working python was found (tried python3, python), so" \
         "neither the channel name nor the consumer path could be read. This" \
         "session opens without a channel." >&2
fi
# --- keep this plugin current, synchronously, before deciding what to open (#753) --
#
# hooks/session-start-update.sh forks scripts/plugin_update.py and returns, by
# design: a SessionStart hook cannot wait on a network call without slowing every
# session start to the speed of the slowest registry. This launcher makes a
# different trade here -- a synchronous, network-touching wait before exec --
# and #753's own measurement (an update that landed mid-session, invisible
# until /oss:doctor happened to be run by hand, minutes later, for an
# unrelated reason) is what makes that trade the right one: a session that
# resolves its plugins BEFORE it starts working never has a stale-copy window
# to be silent about. #1392: the setup diagnostic this comment used to compare
# against ran here too, synchronously, with `OSS_WORKSPACE_SKIP_DOCTOR` as its
# opt-out -- both are gone now, moved into `/oss:run` itself (#1390), which
# diagnoses the repository on every start rather than the launcher diagnosing
# it once before exec.
#
# hooks/session-start-update.sh stays: it is the fallback for a hand-started
# `claude`, which never reaches this file. scripts/plugin_update.py's own
# debounce (#753) means that hook firing a few seconds after this call finds a
# receipt too fresh to re-check and stands down, so this is not a second network
# round-trip on the path that matters.
#
# OSS_NO_AUTO_UPDATE / `auto_update: false` -- the existing opt-out -- governs
# this exactly as it governs the hook: `update()` reads it first and returns
# immediately without touching the network, so an opted-out machine pays nothing
# extra by this running here instead of in the background.
if [ -n "$python_bin" ]; then
    auto_update_line=$("$python_bin" "$plugin_root/scripts/plugin_update.py" \
        --root "$repo_root" --caller launcher --print-state 2>&1 </dev/null) && auto_update_status=0 || auto_update_status=$?
    if [ "$auto_update_status" -ne 0 ]; then
        echo "oss-workspace: could not check whether the oss plugin is current" \
             "(exit status $auto_update_status). Opening the session anyway;" \
             "hooks/session-start-update.sh will try again in the background." >&2
        if [ -n "$auto_update_line" ]; then
            printf '%s\n' "$auto_update_line" >&2
        fi
        oss_step plugin "could not check (exit $auto_update_status)" ask
    else
        auto_update_tab=$(printf '\t')
        IFS="$auto_update_tab" read -r auto_update_state auto_update_from \
            auto_update_to auto_update_detail <<AUTO_UPDATE_LINE
$auto_update_line
AUTO_UPDATE_LINE
        case $auto_update_state in
            updated)
                # #1392: no longer switches $prompt. /oss:run diagnoses on
                # every start (#1390) regardless of whether the plugin just
                # moved, so a launcher-side divert here would be a second,
                # redundant decision about the same fact.
                echo "oss-workspace: the oss plugin was updated from" \
                     "$auto_update_from to $auto_update_to before this session" \
                     "started, so there is no stale-copy window to reload or" \
                     "restart out of. $prompt diagnoses the tree it just moved" \
                     "to on its own first turn." >&2
                oss_step plugin "$auto_update_from → $auto_update_to" ok
                ;;
            current) oss_step plugin "${auto_update_to:-current}" ok ;;
            off)     oss_step plugin "auto-update off" skip ;;
            could-not-check)
                # A THIRD state reporting itself and then saying nothing about
                # why is the defect this whole plugin is about, reproduced
                # inside the check that names it: `$auto_update_detail` is
                # never allowed to render as an empty reason, even though the
                # real script always sets one -- the round trip through a
                # shell `read` is exactly where one could be lost.
                auto_update_reason=$auto_update_detail
                [ -n "$auto_update_reason" ] || auto_update_reason="(no reason was reported -- the plugin-update check printed a could-not-check state with an empty detail field)"
                echo "oss-workspace: could not check whether the oss plugin is" \
                     "current: $auto_update_reason. This is not a statement that" \
                     "it is. Opening $prompt anyway." >&2
                oss_step plugin "could not check" ask
                ;;
            "")
                oss_step plugin "check printed nothing" ask
                echo "oss-workspace: the plugin update check printed nothing" \
                     "this launcher could parse, so whether the oss plugin is" \
                     "current is UNKNOWN. Opening $prompt anyway." >&2
                ;;
            *)
                oss_step plugin "unrecognised state: $auto_update_state" ask
                echo "oss-workspace: the plugin update check reported a state" \
                     "this launcher does not recognise ($auto_update_state), so" \
                     "whether the oss plugin is current is UNKNOWN. Opening" \
                     "$prompt anyway." >&2
                ;;
        esac
    fi
else
    echo "oss-workspace: no working python was found, so the oss plugin could" \
         "not be checked for an update here. hooks/session-start-update.sh" \
         "still covers it once the session is running." >&2
    oss_step plugin "no python, not checked" ask
fi

# --- repoint this launcher's own symlink at the currently installed copy (#753) ---
#
# ~/.local/bin/oss-workspace is what this file's own header tells a maintainer to
# create once; nothing re-points it on a later release, and #289's own history is
# eight consecutive rounds where it silently pinned a superseded copy. The source
# of truth is installed_plugins.json's record for THIS project, read the same way
# `--print-resolved-root` already reads it for #677 -- and NEVER `$plugin_root` or
# `$entry_path`'s own resolved target: a stale link is exactly the case where the
# OLD launcher is the one running, so a repoint derived from "wherever I was
# invoked from" would rewrite the link to the stale target it already names,
# every launch, forever.
#
# Three outcomes, and only two are worth a line: matched (nothing to say), and
# repointed (say so, naming both). `entry_path` not being a symlink at all is the
# ordinary case for a checkout run directly rather than through the documented
# pin, and is left silent -- there is no pin to report on. Once it IS a symlink,
# every OTHER way this can fail to resolve -- the registry unreadable, no record
# for this project, the resolved directory missing its own bin/oss-workspace, the
# link unwritable -- is reported and left untouched, never repointed on a guess.
if [ -n "$python_bin" ] && [ -L "$entry_path" ]; then
    launcher_resolved_root=$("$python_bin" "$plugin_root/scripts/plugin_update.py" \
        --print-resolved-root --root "$repo_root" 2>/dev/null) || launcher_resolved_root=""
    if [ -z "$launcher_resolved_root" ] || [ ! -d "$launcher_resolved_root" ]; then
        echo "oss-workspace: $entry_path is a symlink, but the installed copy for" \
             "$repo_root could not be resolved from installed_plugins.json, so" \
             "whether it is pinned correctly could not be checked. Left" \
             "untouched." >&2
    else
        launcher_repoint_out=$("$python_bin" - "$entry_path" "$launcher_resolved_root" <<'LAUNCHER_REPOINT'
import os
import sys

link_path, resolved_root = sys.argv[1], sys.argv[2]


def done(state, detail=""):
    sys.stdout.write(state + "\n" + detail)
    raise SystemExit(0)


try:
    current_target = os.path.realpath(link_path)
except OSError as exc:
    done("unwritable", str(exc))

resolved_dir = os.path.realpath(resolved_root)
current_dir = os.path.dirname(os.path.dirname(current_target))
if os.path.normcase(os.path.normpath(current_dir)) == os.path.normcase(os.path.normpath(resolved_dir)):
    done("matched")

new_target = os.path.join(resolved_root, "bin", "oss-workspace")
if not os.path.isfile(new_target):
    done("unwritable", "the resolved install has no bin/oss-workspace at %s" % new_target)

tmp = link_path + ".oss-repoint-tmp"
try:
    if os.path.lexists(tmp):
        os.remove(tmp)
    os.symlink(new_target, tmp)
    os.replace(tmp, link_path)
except OSError as exc:
    done("unwritable", str(exc))

done("repointed", "%s -> %s" % (current_target, new_target))
LAUNCHER_REPOINT
) && launcher_repoint_status=0 || launcher_repoint_status=$?
        if [ "$launcher_repoint_status" -eq 0 ]; then
            launcher_repoint_state=$(printf '%s\n' "$launcher_repoint_out" | head -n1)
            launcher_repoint_detail=$(printf '%s\n' "$launcher_repoint_out" | tail -n +2)
            case $launcher_repoint_state in
                repointed)
                    echo "oss-workspace: $entry_path was pinned stale" \
                         "($launcher_repoint_detail) -- repointed at the" \
                         "currently installed copy, so the next launch through" \
                         "it runs current code." >&2
                    ;;
                matched) ;;
                *)
                    echo "oss-workspace: $entry_path could not be repointed at" \
                         "the currently installed copy: $launcher_repoint_detail." \
                         "Left untouched; run ln -sf" \
                         "\"$launcher_resolved_root/bin/oss-workspace\"" \
                         "\"$entry_path\" by hand." >&2
                    ;;
            esac
        else
            echo "oss-workspace: could not check whether $entry_path is pinned" \
                 "correctly (the check crashed, exit status" \
                 "$launcher_repoint_status). Left untouched." >&2
        fi
    fi
fi


# The flag makes this session ABLE to receive channel events. It does not create a
# board: `radar` reads its tiers from this repo's own .supertool.json, and a fresh
# clone has none. Reporting "armed" when only half of that holds is the defect this
# whole plugin is about, so the state is stated rather than assumed -- by the block
# directly below, not by anything further up this file (found by review: this
# paragraph used to sit directly above the code that stated it, and #618's edit
# left it stranded above unrelated python-detection code instead).
#
# Does this repo's board have anything to publish to it? Three states, not one.
#
# This used to be one line: `grep -q radar "$repo_root/.supertool.json"`, which
# also matches `radar_exclusions`, a key spelled `radar-slow`
# (`tests/test_workspace_launcher.py` already carries exactly that fixture for a
# sibling arm), or the word sitting inside a comment. Read the same way
# scripts/doctor.py's own `radar_publish_state` reads it instead: `ops.radar.
# radar_tiers` has to be a non-empty object.
#
# `radar_tiers_declared` is remembered rather than acted on here: the THIRD
# state -- tiers declared, and nothing has EVER spawned on this channel -- needs
# the channel NAME, which is not resolved until further down. It fires from the
# STATE_DIR_CHECK extension of ASK_CONSUMER below, not from this block.
#
# #618's own measurement: a repo can be FORWARDING, subscribed and verified, with
# `watches` saying "the state directory ... does not exist yet, so nothing has
# ever spawned on this channel" -- and this script's one line about the board
# fired on the OPPOSITE case from that harm: no tiers (opted out) warned,
# tiers-and-never-spawned (opted in, and blind) stayed silent.
radar_tiers_declared=0
if [ ! -f "$repo_root/.supertool.json" ]; then
    echo "oss-workspace: no .supertool.json here, so there are no radar tiers and no board to watch. The session still runs, and ops needing a preset will say so." >&2
elif [ -n "$python_bin" ]; then
    radar_tiers_out=$("$python_bin" - "$repo_root/.supertool.json" <<'RADAR_TIERS'
import json, sys

# THREE strings out, not two ("tiers" was already right; "no-tiers" used to
# also mean "could not read the file", which is #652: an unreadable config
# and a real opt-out rendered as the same fact). "unreadable" is now its own
# answer for the OSError/ValueError/non-dict arms, so the caller can tell
# "the maintainer declared no tiers" from "this document could not be read
# the way this script expects" -- two different facts, never one sentence.
try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        doc = json.load(handle)
except (OSError, ValueError):
    print("unreadable")
    raise SystemExit(0)
if not isinstance(doc, dict):
    print("unreadable")
    raise SystemExit(0)
ops = doc.get("ops")
block = ops.get("radar") if isinstance(ops, dict) else None
tiers = block.get("radar_tiers") if isinstance(block, dict) else None
print("tiers" if isinstance(tiers, dict) and tiers else "no-tiers")
RADAR_TIERS
) && radar_tiers_status=0 || radar_tiers_status=$?
    # Status captured on the heredoc opener itself, not on a line after it --
    # #588's shape, restated here rather than only in the ASK_CONSUMER block
    # below, because a crashed interpreter is a THIRD way to reach this
    # question with no real answer, on top of the two "unreadable" already
    # covers from inside the probe.
    if [ "${radar_tiers_status:-1}" -ne 0 ]; then
        radar_tiers_out=unreadable
    fi
    if [ "$radar_tiers_out" = "tiers" ]; then
        radar_tiers_declared=1
    elif [ "$radar_tiers_out" = "unreadable" ]; then
        radar_tiers_declared=unknown
        echo "oss-workspace: whether .supertool.json declares radar tiers is UNKNOWN, not absent -- the file exists but could not be read as the JSON object this script expects (or the probe reading it crashed). Check delivery with supertool 'channel:health' before trusting a green board." >&2
    else
        echo "oss-workspace: .supertool.json declares no radar tiers, so the channel is open and nothing publishes to it. Check delivery with supertool 'channel:health' before trusting a green board." >&2
    fi
else
    # No working python here, so this document cannot actually be parsed --
    # the grep below is a weak, best-effort signal, not a read of the JSON,
    # and #652 is the record of treating its silence as a confirmed "no
    # tiers". It also matches `radar_exclusions`, a key spelled `radar-slow`,
    # or the word sitting inside a comment (see the block comment above), so
    # a MATCH is no more conclusive than a non-match: neither is a state this
    # arm can assert as fact, so both report UNKNOWN and differ only in the
    # weak signal named. The THIRD state below still needs python regardless
    # of what this arm decides, since #627's STATE_DIR_CHECK never runs
    # without one.
    radar_tiers_declared=unknown
    if grep -q radar "$repo_root/.supertool.json" 2>/dev/null; then
        echo "oss-workspace: .supertool.json mentions \"radar\", but there is no python here to parse it, so whether it declares radar tiers is UNKNOWN rather than confirmed. Check delivery with supertool 'channel:health' before trusting a green board." >&2
    else
        echo "oss-workspace: .supertool.json does not mention \"radar\", but there is no python here to parse it properly, so whether it declares radar tiers is UNKNOWN rather than absent. Check delivery with supertool 'channel:health' before trusting a green board." >&2
    fi
fi

# ONE sentence for where this session ACTUALLY lands when any arm below refuses, and
# it is computed here rather than restated by each arm (#270).
#
# An already-exported SUPERTOOL_WATCH_NAME wins over both roads, so a refusal costs
# nothing and the session stays on that channel; only when there is no export does a
# refusal mean the shared default socket. `7b2841c` computed that sentence inside the
# gate below and left every other refusal site claiming the shared socket
# unconditionally -- a state the process is demonstrably not in, and it takes the true
# half with it, because refusing blanks `$watch_name` and the "an export wins" line
# further down only fires while that variable is non-empty.
#
# There were NINE such sites, not the three the issue names: DERIVE_NAME carries five
# and one of those has its "SHARED DEFAULT" split across two source lines by string
# concatenation, so a grep for the phrase does not find it. Nine independent statements
# of one fact is exactly what let one get fixed and the rest not, so there is now one
# statement and every arm is handed the answer.
#
# `ascii()`, not `%r`: repr leaves non-ASCII alone, and this sentence is written to the
# stdout of child interpreters and to consoles whose codepage may not carry it. An
# ASCII-by-construction receipt needs no error handler and no platform to be measured.
# That is #271's hazard reached from the other side, and a construction rather than an
# assertion that a construction is safe.
watch_landing="Nothing was exported and this session is on the SHARED DEFAULT socket, shared with every other repo that declares none."
if [ -n "${SUPERTOOL_WATCH_NAME:-}" ]; then
    watch_landing_name=$SUPERTOOL_WATCH_NAME
    if [ -n "$python_bin" ]; then
        # A failure here is not worth a receipt of its own: the fallback is the raw
        # value, which is what every other shell arm in this file already prints.
        watch_landing_name=$("$python_bin" -c 'import sys; sys.stdout.write(ascii(sys.argv[1]))' "$SUPERTOOL_WATCH_NAME" 2>/dev/null) \
            || watch_landing_name=$SUPERTOOL_WATCH_NAME
    fi
    watch_landing="SUPERTOOL_WATCH_NAME is already exported as $watch_landing_name and wins, so this session uses that channel and nothing was exported over it."
fi

# The channel NAME is this repo's state and is read from its own .supertool.json,
# then exported — a stdio MCP server the harness spawns inherits this process's
# environment, which is what carries the name to the consumer.
#
# There are FOUR answers here, not one name-or-nothing, which is why this block
# prints a tagged line rather than a bare name:
#
#   name=<x>     exactly one distinct declared name — export it
#   conflict     two or more op blocks declare different names, already reported
#                on stderr. A state this script cannot resolve, so it exports
#                nothing AND derives nothing (see the guard below).
#   unreadable   the file exists and will not parse, so what it declares is
#                UNKNOWN rather than absent — also refused, for the same reason.
#   unencodable  a name IS declared and this session's stdout cannot carry it, so
#                it cannot be read back (#271). Refused for the same reason: a
#                declaration that exists is not a declaration that is absent.
#   (nothing)    no .supertool.json, or none of its op blocks declares a name —
#                absence, and the case the derivation exists for.
#
# And a sixth answer that is not a tag, because the block did not get far enough to
# print one: a NON-ZERO EXIT with no answer. That used to be swallowed whole by a
# trailing `|| true` and arrive as the empty string, which reads as "declares none",
# which derives. It is caught by status below instead.
#
# All three of the last used to arrive as an empty string, and the derivation
# guard below tested emptiness, so a refusal was printed to stderr and a derived
# name was exported anyway: `none exported` on one stream, SUPERTOOL_WATCH_NAME
# on the other. Distinguishing them is the whole point of the tag; a bare name
# cannot be mistaken for a tag and no tag can be forged by a declared value,
# because every declared value arrives prefixed.
#
# The guard is an `if` and not `[ -n "$x" ] && ...` inside the substitution: a
# heredoc opened by the right-hand side of `&&` and then followed by `|| true` is
# a syntax error under bash -- `syntax error near unexpected token ||` -- while
# macOS's /bin/sh parsed it and every local run stayed green.
watch_name=""
watch_name_state=undeclared
read_name_out=""
read_name_status=0
if [ -n "$python_bin" ]; then
read_name_out=$("$python_bin" - "$repo_root/.supertool.json" "$watch_landing" <<'READ_NAME'
import json, sys

# The one landing sentence is passed IN (#270). A caller that passes none gets a third
# state rather than a crash or a confident claim about a socket: this program is
# extracted and run by other callers -- `tests/test_doctor_inprocess.py` does exactly
# that to DERIVE_NAME below -- and such a caller has no session to report on.
# Defaulting to "the shared default socket" would put a confident wrong sentence in
# the mouth of anybody who forgot the argument, which is the defect being fixed here.
landed = sys.argv[2] if len(sys.argv) > 2 else (
    "Where this session landed was not established: no landing sentence reached "
    "this block."
)

# The exception in hand decides which answer this is, the same way DERIVE_NAME
# below decides it — absence and unreadability are two states and asking the
# filesystem a second question to tell them apart is how Path.exists() took the
# release gate down from inside the except meant to survive a bad read.
try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        doc = json.load(handle)
except FileNotFoundError:
    # No file is genuinely "declares none", which is the case the derivation
    # below exists for (#191). Printing nothing is that answer.
    raise SystemExit(0)
except (OSError, ValueError) as err:
    # A file that will not parse has NOT declared none — what it declares is
    # unknown, and a derived name would be one the ops in that very file may
    # contradict. So this refuses too, and says the same thing the code does.
    print("unreadable")
    sys.stderr.write(
        "oss-workspace: %s could not be read (%s), so no channel name was exported "
        "and none was derived either — what that file declares is unknown, not "
        "absent. %s supertool 'channel:health'\n"
        % (sys.argv[1], type(err).__name__, landed))
    raise SystemExit(0)

ops = doc.get("ops") if isinstance(doc, dict) else None
names = sorted({
    block["watch_name"]
    for block in (ops or {}).values()
    if isinstance(block, dict) and isinstance(block.get("watch_name"), str)
    and block["watch_name"]
})
if len(names) == 1:
    name = names[0]
    # stdout is the TRANSPORT here, not a display: the shell reads this line back and
    # exports what it holds. So the question is whether this stream can CARRY the name,
    # and it is answered by encoding the actual bytes rather than by consulting a table
    # of codepages — the platform is measured, never assumed (#271).
    #
    # An explicit strict encode rather than a try/except around the write, because the
    # two failures are not the same one. `PYTHONIOENCODING` can put a `replace` handler
    # on this stream, and a mangled name would then be exported with no exception for
    # any handler to catch: a private socket nobody publishes to, which is the quiet
    # half of this bug and the half a try/except cannot see.
    encoding = sys.stdout.encoding or "utf-8"
    try:
        ("name=" + name).encode(encoding, "strict")
    except (UnicodeEncodeError, LookupError) as err:
        # The third state, and the only honest one. Printing the name mangled is a
        # receipt nobody can act on plus an export nobody asked for; refusing to launch
        # trades the product for an enhancement. This says what is true — a name is
        # declared and this stream cannot carry it — in the same shape as `conflict`
        # and `unreadable` above: export nothing, derive nothing, say so, open anyway.
        #
        # The tag and the value's rendering are ASCII by construction: `ascii()` on the
        # name, a plain word on stdout. A receipt quoting the value raw would be killed
        # by the very thing it is reporting.
        print("unencodable")
        sys.stderr.write(
            "oss-workspace: %s declares watch_name %s, which this session's stdout "
            "(%s) cannot carry (%s) — so it could not be read back and nothing was "
            "exported, and nothing was derived over it either, because a declaration "
            "that exists is not a declaration that is absent. %s "
            "supertool 'channel:health'\n"
            % (sys.argv[1], ascii(name), encoding, type(err).__name__, landed))
        raise SystemExit(0)
    print("name=" + name)
elif names:
    # Tagged on stdout AND explained on stderr, because the two have to agree:
    # the tag stops the derivation below from firing, and this sentence is the
    # only thing that tells the caller it did not.
    print("conflict")
    # `ascii()` per name, for the same reason the arm above uses it and this one
    # did not (#323). These strings come out of `json.loads` of the MANAGED repo's
    # tracked `.supertool.json`, so they arrive by ordinary contribution — and this
    # arm returns before anything validates them: `watch_name_problem` is never
    # called on this route. Raw, a newline forged a second line reading as this
    # launcher's own output, and a CSI sequence erased and rewrote what the terminal
    # had already printed. Measured, not argued: the receipt came out as THREE lines,
    # the second of them a column-0 `VERDICT: ok`, which is the shape this same file
    # parses a verdict out of further down.
    #
    # Per NAME rather than around the join, which is not cosmetic: `ascii()` on the
    # joined string would delimit the whole list once, so a value containing `", "`
    # still forges a list separator and reads as two declared channels. Quoting each
    # element makes the count of channels a property of the code rather than of the
    # input.
    #
    # `ascii()` and not `%r`: repr leaves non-ASCII alone, and this line is written
    # to a console whose codepage may not carry it. ASCII by construction needs no
    # error handler and no platform to be measured (#271).
    sys.stderr.write(
        "oss-workspace: op blocks disagree about watch_name (%s) — none exported, "
        "and none derived from .oss.json either: the ops are already on different "
        "channels, so a name derived from the repo would be one nothing here "
        "publishes to — an uncontested socket carrying no events, which reads as "
        "healthy. %s Fix that file, then run supertool 'channel:health'\n"
        % (", ".join(ascii(n) for n in names), landed))
READ_NAME
) || read_name_status=$?
# The trailing `|| true` that used to sit on the heredoc opener above swallowed two
# different failures into one silence: a stdout that could not carry the declared name
# (#271, now answered inside the block by the `unencodable` tag) and any OTHER uncaught
# exception — a RecursionError out of `json.load` on a deeply nested file, say, which
# is neither OSError nor ValueError. Both arrived at the `case` below as the empty
# string, which reads as `undeclared`, which derives over a file nobody read.
#
# The swallow is still here, because a launcher must open the session: `set -e` would
# otherwise turn a bad `.supertool.json` into no session at all. What changed is that
# it is no longer silent and no longer means "this file declares none".
if [ "$read_name_status" -ne 0 ]; then
    watch_name_state=crashed
    echo "oss-workspace: reading $repo_root/.supertool.json ended with status" \
         "$read_name_status and no answer, so what it declares is unknown rather" \
         "than absent — nothing was exported and nothing was derived." \
         "$watch_landing supertool 'channel:health'" >&2
else
    case "$read_name_out" in
        name=*)      watch_name=${read_name_out#name=}; watch_name_state=declared ;;
        conflict)    watch_name_state=conflict ;;
        unreadable)  watch_name_state=unreadable ;;
        unencodable) watch_name_state=unencodable ;;
    esac
fi
fi

# Nothing declared a name (#191). Falling through here exports nothing, so the
# consumer binds the UNNAMED socket /tmp/supertool-watch.sock — shared with every
# other repo that declares none, held by exactly one process, first one wins, and
# the loser is never told. Measured 2026-08-15: a second channel-capable server
# held it, five events were read and forwarded with zero dropped, and none of them
# reached the session. `channel:health` said FORWARDING throughout, correctly — it
# cannot see WHICH server holds the socket, and its own report says so.
#
# So derive one. `.oss.json` carries `repo`: tracked, authoritative, and read every
# tick anyway. NOT the directory basename — that changes when somebody clones
# elsewhere, and two unrelated repos cloned to the same basename collide silently,
# which is this same defect reached by a different road.
#
# Tracked means it arrives by ordinary contribution, so it is VALIDATED before it
# is folded, through the same `oss_config.repo_problem` that scaffold and doctor
# use, and refused rather than sanitised when that fails (#207). That refusal is a
# FIFTH answer in the same shape as the four above: nothing derived, said out loud,
# session opens anyway. A launcher that exited over a bad config would trade the
# product for an enhancement.
#
# It fires on `undeclared` ONLY — never on `conflict`, never on `unreadable`. A
# repo whose op blocks contradict each other has not failed to choose a channel,
# it has chosen two, and neither is the one a derivation would invent; a repo
# whose config will not parse has declared something nobody can read. Deriving in
# either swaps a loud wrong state (the shared socket, announced) for a quiet one
# (a private socket nobody publishes to, indistinguishable from working).
watch_name_source="declared in $repo_root/.supertool.json"
derive_name_status=0
if [ "$watch_name_state" = undeclared ] && [ -n "$python_bin" ]; then
    watch_name_source="derived from repo in $repo_root/.oss.json"
    watch_name=$("$python_bin" - "$repo_root/.oss.json" "$plugin_root/scripts" "$watch_landing" <<'DERIVE_NAME'
import json, sys

# The one landing sentence is passed IN (#270), and a caller that passes none gets a
# third state rather than a confident claim about a socket. That caller is real:
# `tests/test_doctor_inprocess.py` extracts this program and runs it against its own
# fixtures to cross-check doctor's copy of the derivation rule, and it has no session
# to report on. A crash there would have made this program answer a question about
# derivability with a traceback; a default of "the shared default socket" would have
# had it answer confidently about a session that does not exist.
landed = sys.argv[3] if len(sys.argv) > 3 else (
    "Where this session landed was not established: no landing sentence reached "
    "this block."
)

# The rule for what `repo` may be lives in scripts/oss_config.py, where
# scaffold.repo_slug and doctor already read it. This block used to carry a
# character class of its own that permitted `.`, `..` and a leading `-` -- the one
# consumer of `repo` in this plugin with a guard of its own, running at SESSION
# START, before anything that would have refused the value (#207). A second
# spelling of a rule is a second rule, so it is imported rather than restated.
sys.path.insert(0, sys.argv[2])
try:
    import oss_config
except Exception as err:
    # A third state, and it is not the clean one. Falling back to the old
    # unvalidated fold here would make the guard disappear in exactly the case
    # where it is missing, which is the absence this plugin is named after.
    sys.stderr.write(
        "oss-workspace: the config validator could not be loaded from %s (%s), so "
        "no channel name could be derived. %s supertool 'channel:health'\n"
        % (sys.argv[2], type(err).__name__, landed))
    raise SystemExit(0)

# The exception in hand decides which answer this is. Asking the filesystem a
# second question to explain why the first failed is how Path.exists() took the
# release gate down from inside the except that was meant to survive a bad read.
try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        doc = json.load(handle)
except FileNotFoundError:
    sys.stderr.write(
        "oss-workspace: no %s, so nothing could be derived. %s "
        "supertool 'channel:health'\n" % (sys.argv[1], landed))
    raise SystemExit(0)
except (OSError, ValueError) as err:
    sys.stderr.write(
        "oss-workspace: %s could not be read (%s), so no channel name could be "
        "derived. %s supertool 'channel:health'\n"
        % (sys.argv[1], type(err).__name__, landed))
    raise SystemExit(0)

repo = doc.get("repo") if isinstance(doc, dict) else None
if not isinstance(repo, str) or not repo.strip():
    sys.stderr.write(
        "oss-workspace: %s declares no repo, so nothing could be derived. %s "
        "supertool 'channel:health'\n" % (sys.argv[1], landed))
    raise SystemExit(0)

# The value is validated before it is folded, by the same function scaffold and
# doctor use. Refusing rather than sanitising here is the FOURTH arm of the shape
# above -- nothing derived, said out loud, session opens anyway -- and it is the
# right trade for a launcher: the channel is an enhancement, the session is the
# product, and a substituted name would be a private socket nobody publishes to.
#
# The raw value is validated, not `repo.strip()`: a slug with whitespace around it
# is refused by every other consumer, and a launcher accepting what the rest of the
# plugin rejects is exactly the asymmetry this closes.
name, problem = oss_config.watch_channel_name(repo)
if problem:
    # `problem` quotes the repo value back with `{!r}`, which escapes a newline, a
    # control character and anything a terminal would act on -- so nothing here
    # needs a sanitiser in front of it, and `sys.stderr` defaults to
    # `backslashreplace`, so a codepage that cannot represent the value escapes it
    # rather than raising. Both measured rather than assumed (#207).
    sys.stderr.write(
        "oss-workspace: %s -- %s. Nothing was derived: the launcher refuses what "
        "every other consumer of this value refuses rather than folding it into a "
        "name that becomes a socket path. %s supertool 'channel:health'\n"
        % (sys.argv[1], problem, landed))
    raise SystemExit(0)

# The fold still runs after the validator: an accepted slug is any pair of
# non-slash, non-whitespace runs, so characters a socket path should not hold
# still reach it. What the validator adds is that the one slash always becomes a
# dash, so the result carries no separator and is never `.` or `..`.
# ASCII by construction, so this print cannot raise the way READ_NAME's could
# (#271): `oss_config.WATCH_NAME_UNSAFE_RE` folds everything outside [A-Za-z0-9._-]
# to a dash before the value reaches here. That is a property of the fold rather
# than of the input, which is why this arm needs no encode check and the declared
# route does. Confirmed against the fold, not assumed from the character class.
print(name)
DERIVE_NAME
) || derive_name_status=$?
    # Same swallow, same reason, same narrowing as READ_NAME above. A DERIVE_NAME that
    # dies (RecursionError out of `json.load`, say — neither OSError nor ValueError)
    # left `$watch_name` empty and printed NOTHING on either stream, so the session
    # landed on the shared default socket with no line saying so. That is this repo's
    # own defect class: the absence was produced by the tool.
    if [ "$derive_name_status" -ne 0 ]; then
        watch_name=""
        echo "oss-workspace: deriving from $repo_root/.oss.json ended with status" \
             "$derive_name_status and no answer, so no channel name was derived and" \
             "what that file carries is unknown rather than absent." \
             "$watch_landing supertool 'channel:health'" >&2
    fi
fi

# ONE gate, both routes (#230).
#
# Above this line a name arrives by two roads: DECLARED in this repo's tracked
# .supertool.json, or DERIVED from `repo` in .oss.json. #207 routed the second
# through oss_config and left the first exporting whatever it read — a guard and its
# bypass a hundred lines apart in one file. Measured before the fix: a declared name
# of `../../../tmp/pwned` was exported as `../../../tmp/pwned`, and one carrying a
# newline was exported carrying it.
#
# The fix is not "validate the declared name with the function the derived route
# uses". That function takes an `owner/name` slug and folds it; a declared name is
# not a slug and would be refused for having no `/`. What both roads produce is a
# value of the same KIND — a watch channel name — so there is now one statement of
# what such a value may be, and it is called HERE, once, after the roads converge.
# That is what makes "no bypass" a property of the code rather than a promise: a
# bypass is a road that does not reach the gate, and there is no other road.
#
# What the rule refuses is narrow on purpose, and the cost of getting it wrong falls
# on somebody who declared a name deliberately. It refuses only what this plugin can
# argue without knowing anything about supertool: a value that is not usable as a
# PATH COMPONENT, because the consumer renders the name into a socket path and a
# poller state directory. It does NOT apply the consumer's own NAME_RE, which caps
# the length at 32 and constrains the first character — transcribing that here would
# put a second spelling of somebody else's rule in this repository to drift, and
# would take a working private channel away from any repo whose consumer accepts a
# name this copy does not. That question is asked of the consumer and reported
# instead (#231).
#
# A refusal is the same shape as every other arm here: export nothing, say so on
# stderr, open the session anyway. And it refuses when it CANNOT CHECK, which is why
# the `-z "$python_bin"` arm exists at all: `$watch_name` can only be non-empty when
# a python was found, so that arm is unreachable today. It is written because
# falling through to an unvalidated export the moment the validator goes missing is
# the absence this plugin is named after, and a future edit that produced a name
# without python would otherwise reopen the bypass silently.
#
# The gate is handed `$watch_landing`, the sentence computed once at the top of this
# block, and so is every sibling arm above it. That was the whole of #270: this gate
# learned the true state on `7b2841c` and the other eight refusal sites went on
# claiming the shared default socket unconditionally, which is a state the process is
# demonstrably not in whenever SUPERTOOL_WATCH_NAME is already exported — and it takes
# the true half with it, because refusing blanks `$watch_name` and the "an export
# wins" line below only fires while that variable is non-empty.
if [ -n "$watch_name" ]; then
    if [ -z "$python_bin" ]; then
        echo "oss-workspace: no working python, so the watch channel name" \
             "($watch_name_source) could not be checked and was not exported." \
             "$watch_landing supertool 'channel:health'" >&2
        watch_name=""
    elif ! "$python_bin" - "$watch_name" "$watch_name_source" "$plugin_root/scripts" \
                          "$watch_landing" <<'CHECK_NAME'
import sys

# Imported, not restated. A second spelling of a rule is a second rule, and this
# script has already paid for that once: the character class DERIVE_NAME used to
# carry permitted `.`, `..` and a leading `-` where scaffold and doctor refused them.
sys.path.insert(0, sys.argv[3])

# Which socket the session ACTUALLY lands on when this gate refuses, computed ONCE in
# the shell above and handed to every arm that needs it (#270). A receipt describing
# the wrong state is worse than no receipt: it is read, believed, and stops the reader
# looking. This block used to compute the sentence itself, which made it correct and
# the eight sibling arms wrong — the cost of a fact stated nine times.
#
# Short argv is a third state here too, for the same reason it is in the two blocks
# above: this program is a program, and a caller that passes no sentence must not be
# handed a confident one.
landed = sys.argv[4] if len(sys.argv) > 4 else (
    "Where this session landed was not established: no landing sentence reached "
    "this block."
)

try:
    import oss_config
except Exception as err:
    # Could not check is not clean. Exporting the name anyway here would delete the
    # guard in exactly the case where it is missing.
    sys.stderr.write(
        "oss-workspace: the config validator could not be loaded from %s (%s), so the "
        "watch channel name (%s) could not be checked. %s "
        "supertool 'channel:health'\n"
        % (sys.argv[3], type(err).__name__, sys.argv[2], landed))
    raise SystemExit(1)

problem = oss_config.watch_name_problem(sys.argv[1])
if problem:
    # `problem` quotes the value back with `{!r}`, which escapes a newline, a control
    # character and anything a terminal would act on — and sys.stderr defaults to
    # `backslashreplace`, so a codepage that cannot represent it escapes rather than
    # raising. Both measured rather than assumed (#207), and the reason nothing here
    # needs a sanitiser in front of it.
    sys.stderr.write(
        "oss-workspace: %s -- %s. %s supertool 'channel:health'\n"
        % (sys.argv[2], problem, landed))
    raise SystemExit(1)
CHECK_NAME
    then
        watch_name=""
    fi
fi

# An exported value is the one a running poller already captured, and moving the
# paths underneath a live fleet is a documented failure. So an export wins — and
# both values are named, because a name losing quietly is the other half of it.
if [ -n "${SUPERTOOL_WATCH_NAME:-}" ]; then
    if [ -n "$watch_name" ] && [ "$watch_name" != "$SUPERTOOL_WATCH_NAME" ]; then
        echo "oss-workspace: SUPERTOOL_WATCH_NAME is already exported as" \
             "${SUPERTOOL_WATCH_NAME} and wins; $watch_name was" \
             "$watch_name_source. The pollers this session spawns follow the" \
             "export; ops already running elsewhere do not." \
             "supertool 'channel:health'" >&2
    fi
elif [ -n "$watch_name" ]; then
    export SUPERTOOL_WATCH_NAME="$watch_name"
fi

# Will the consumer actually ACCEPT this name? (#231)
#
# Everything above decides what to export. Nothing above knows whether the thing on
# the other end will use it. Measured against this organisation's real slugs on
# 2026-08-16: `Digital-Process-Tools/claude-oss` derives a 32-character name that
# supertool accepts exactly at its cap, while `claude-supertool` (38) and
# `claude-jit-context` (40) derive names it discards and falls back to the shared
# default socket — the state #191 exists to eliminate, reached while this script's
# own output implies a private channel. Two of the three repositories this plugin
# runs on are in it. This one works by one character, which is why nobody saw it.
#
# REPORT, do not refuse, and do not transcribe. A copy of supertool's NAME_RE in
# this repository would drift from the installed one, and refusing on a cap this
# copy carried would take a working channel away from a repo whose consumer accepts
# the name. So the rule is ASKED FOR: read out of the installed
# presets/watch/naming.py at run time, which is a fact about the version actually on
# this machine rather than a fact about when this file was last edited.
#
# Three states, and silence belongs to exactly one of them:
#
#   accepted        say nothing. A line printed on every healthy launch is furniture,
#                   and furniture is how the line that matters stops being read.
#   rejected        say so loudly, with the name, its length and the rule, because
#                   "too long" without a number is unactionable.
#   could not ask   say so loudly TOO, with the name and its length. Silence here
#                   would be indistinguishable from acceptance, which is the absence
#                   this plugin is named after.
#
# With no supertool installed at all there is no fourth state to report: the consumer
# block below already says so with its own remedy, and a second line would be
# furniture on a path where it is never actionable.
if [ -n "${SUPERTOOL_WATCH_NAME:-}" ] && [ -n "$python_bin" ]; then
# `&& ask_consumer_status=0 || ask_consumer_status=$?` on the opener itself --
# not a trailing `|| true` after the heredoc closes -- because a bare simple
# command in an `if` BODY is exactly where `set -eu` (:31) applies, and the
# ORIGINAL `|| true` this heredoc used to end in was doing two jobs at once:
# swallowing the status AND suppressing errexit. #573 replaced only the first
# job, leaving `set -eu` free to kill the whole script the instant this probe
# crashes -- before `ask_consumer_status=$?` two lines below it could ever run,
# and before the 34-line "could not ask" arm that exists to report exactly that
# state got a chance to (#588). This idiom is the one the doctor-diagnostic call
# below already uses for the identical reason.
#
# `${radar_tiers_declared:-0}`, not a bare `$radar_tiers_declared` (#627):
# `tests/test_ask_consumer_573.py` extracts this WHOLE `if`/heredoc/`fi` block,
# starting at the `if [ -n "${SUPERTOOL_WATCH_NAME:-}" ]...` line above, and
# runs it standalone under `sh` with only `python_bin` and
# `SUPERTOOL_WATCH_NAME` set -- that is the block's own tested contract, not an
# oversight in the fixture, and `radar_tiers_declared` is assigned outside the
# extracted region. A bare reference is a `set -u` failure the instant that
# variable is unset, which is `#588`'s shape again: the block dies at THIS
# line, before the crashed-probe arm three states down ever gets to run. The
# default makes the block independently satisfiable the way its own harness
# already assumes, and is a no-op wherever the whole script runs the normal
# way, since `radar_tiers_declared` is always assigned by the time this line
# is reached there.
"$python_bin" - "$SUPERTOOL_WATCH_NAME" "${radar_tiers_declared:-0}" <<'ASK_CONSUMER' && ask_consumer_status=0 || ask_consumer_status=$?
import importlib.util, json, os, sys

name = sys.argv[1]
# "1" only when .supertool.json declares a non-empty ops.radar.radar_tiers,
# decided further up this script (#618). Anything else -- including a caller
# that ran this program standalone with no second argv, the way
# tests/test_doctor_inprocess.py extracts DERIVE_NAME above -- is "not
# declared", never "declared", so a missing argument cannot forge the state
# this block goes on to warn about.
#
# THREE states arrive here now, not two (#652): "1" (declared), "unknown"
# (the earlier block could not read .supertool.json, or had no python to
# parse it), and anything else, including a missing argv, meaning "not
# declared". `tiers_unknown` is checked below the STATE_DIR_CHECK gate so an
# unreadable config is reported as SKIPPED rather than silently read as "not
# declared" -- which used to switch off #627's never-spawned-board check
# with no receipt that anything had been skipped.
radar_state = sys.argv[2] if len(sys.argv) > 2 else "0"
tiers_declared = radar_state == "1"
tiers_unknown = radar_state == "unknown"


def cannot_ask(why):
    # The name is quoted with %r, which escapes a newline or anything a terminal
    # would act on -- and this arm is reachable with an UNVALIDATED name, because an
    # already-exported SUPERTOOL_WATCH_NAME wins and never goes through the gate.
    sys.stderr.write(
        "oss-workspace: could not ask the installed supertool whether it will accept "
        "the watch channel name %r (%d characters) -- %s. So this session is on a "
        "private socket or on the shared default one and nothing here can tell you "
        "which. supertool 'channel:health'\n" % (name, len(name), why))


# The registry, not a glob of the cache: the cache keeps every version ever
# installed and a glob answers with whichever sorts last, which is a version this
# session is not running. Same resolution and same order as FIND_CONSUMER below.
registry = os.path.expanduser("~/.claude/plugins/installed_plugins.json")
try:
    with open(registry, encoding="utf-8") as handle:
        doc = json.load(handle)
except (OSError, ValueError):
    # Reported by the consumer block below, with the remedy. Not restated here.
    raise SystemExit(0)

# Guarded the way scripts/doctor.py's _consumer_watch_name_verdict guards the
# identical read (#546): a shape that cannot be understood must reach
# `cannot_ask()`, not an unhandled AttributeError that `|| true` used to swallow
# whole. Unlike doctor.py's mirror, a MALFORMED plugins/entries/entry is tracked
# separately from a genuinely ABSENT one -- "no supertool key at all" stays silent
# here (the FIND_CONSUMER block below reports that with its own remedy), while
# "there is something here and it could not be read" is loud, because those are
# different states and only one of them is actionable via `cannot_ask()`.
if not isinstance(doc, dict):
    cannot_ask("%s is not a JSON object" % registry)
    raise SystemExit(0)

plugins = doc.get("plugins")
if plugins and not isinstance(plugins, dict):
    cannot_ask("%s's \"plugins\" entry is not a JSON object" % registry)
    raise SystemExit(0)
if not isinstance(plugins, dict):
    plugins = {}

installs = []
malformed = ""
for key, entries in plugins.items():
    if key.split("@")[0] != "supertool":
        continue
    if entries and not isinstance(entries, list):
        malformed = "%s's supertool entry is not a JSON array" % registry
        continue
    for entry in (entries if isinstance(entries, list) else []):
        if not isinstance(entry, dict):
            malformed = "%s lists a supertool install entry that is not a JSON object" % registry
            continue
        if entry.get("installPath"):
            installs.append(entry.get("installPath"))

if not installs:
    if malformed:
        cannot_ask(malformed)
    raise SystemExit(0)


rule_path = ""
for path in installs:
    candidate = os.path.join(path, "presets", "watch", "naming.py")
    if os.path.isfile(candidate):
        rule_path = candidate
        break
if not rule_path:
    cannot_ask("none of %s holds presets/watch/naming.py, so that version either "
               "predates the watch preset or keeps its rule somewhere else"
               % ", ".join(installs))
    raise SystemExit(0)

# Reading the rule means executing the dependency's module. That is a smaller
# exposure than this script already takes -- the consumer from the same install is
# about to be registered as an MCP server and spawned -- and it is the only way to
# get the rule of the version actually installed rather than a copy of one.
#
# SystemExit is caught beside Exception because a module calling sys.exit() on
# import would otherwise end this block with no receipt, which reads as accepted.
# KeyboardInterrupt is deliberately NOT caught: a launcher must stay interruptible.
try:
    spec = importlib.util.spec_from_file_location("_oss_watch_naming", rule_path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    rule = module.NAME_RE
    pattern = rule.pattern
    accepted = bool(rule.match(name))
except (Exception, SystemExit) as err:
    cannot_ask("%s could not be read (%s)" % (rule_path, type(err).__name__))
    raise SystemExit(0)

# STATE_DIR_CHECK (#618): has anything EVER spawned on the channel this session
# is about to use? Independent of `accepted` above and run regardless of it --
# `module.resolve()` (below) falls back to the shared default paths on its own
# when the name is rejected, so this reads the paths the consumer will actually
# use either way rather than the ones this script guessed.
#
# ASKED, not transcribed, for the same reason `accepted` above is asked rather
# than matched against a copy of NAME_RE kept in this file: `resolve()` is read
# out of the SAME already-imported module, off the version actually installed,
# so a future supertool changing where poller slots live changes what this
# reads too. `getattr` rather than a bare attribute access: an older installed
# naming.py may have `NAME_RE` and nothing else, and answering "never spawned"
# from a module that cannot even compute the path would be a confident wrong
# receipt about a question nothing here actually asked.
#
# THREE states, not two, and the third was the bug found by review: the first
# cut of this block folded "could not check" -- no `resolve()` on this
# version, `resolve()` raising, or `os.stat` raising something other than
# `FileNotFoundError` -- into the same silent no-output as "checked, and it is
# healthy". That is exactly the shape this file's own doctrine a few lines up
# forbids for `cannot_ask()`'s identical question ("Silence here would be
# indistinguishable from acceptance, which is the absence this plugin is
# named after") -- restated here rather than only above it, because the
# silence this time was in NEW code repeating an old mistake, not a gap in an
# existing one.
if tiers_unknown:
    # #652's composition: an unreadable .supertool.json used to leave
    # `radar_tiers_declared` at its `0` default, which silently switched off
    # this whole check with no receipt that it had been skipped. Reported
    # loudly instead -- and NOT as "never existed", which would be a claim
    # about a board this script never confirmed was declared at all.
    sys.stderr.write(
        "oss-workspace: whether .supertool.json declares radar tiers is "
        "UNKNOWN, so whether anything has ever spawned on this channel was "
        "not checked either -- skipped, not healthy. supertool "
        "'channel:health'\n")
elif tiers_declared:
    state_dir_could_not_check = ""
    resolve_fn = getattr(module, "resolve", None)
    if not callable(resolve_fn):
        state_dir_could_not_check = (
            "%s has no resolve() to ask (only NAME_RE, or nothing usable at "
            "all) -- this may be an older supertool" % rule_path)
    else:
        try:
            state_dir = resolve_fn().state_dir
        except Exception as err:
            state_dir_could_not_check = (
                "%s's resolve() raised %s" % (rule_path, type(err).__name__))
            state_dir = ""
        if not state_dir_could_not_check and not state_dir:
            state_dir_could_not_check = "%s's resolve() returned no state_dir" % rule_path
        if not state_dir_could_not_check:
            # The exception in hand decides absence from unreadable -- the
            # same rule CLAUDE.md's `_read_config`/`Path.exists()` trap is
            # about, one layer down: `os.path.isdir` or `Path.exists()` would
            # swallow a permission error or an over-length path into the same
            # bare False a genuine absence produces, and this line would then
            # be unable to tell "never spawned" from "could not look".
            try:
                os.stat(state_dir)
                never_spawned = False
            except FileNotFoundError:
                never_spawned = True
            except OSError as err:
                never_spawned = False
                state_dir_could_not_check = (
                    "%s could not be examined (%s)" % (state_dir, type(err).__name__))
            if never_spawned:
                sys.stderr.write(
                    "oss-workspace: .supertool.json declares radar tiers, but the "
                    "poller state directory %s has never existed, so nothing has "
                    "ever spawned on this channel -- a verified, subscribed, "
                    "forwarding channel with an empty fleet renders identically "
                    "to a healthy board with nothing to report. Run "
                    "supertool 'radar' to raise one. supertool 'channel:health'\n"
                    % state_dir)
    if state_dir_could_not_check:
        sys.stderr.write(
            "oss-workspace: .supertool.json declares radar tiers, but whether "
            "anything has ever spawned on this channel could not be checked -- "
            "%s. Not answered as either state: silence here would be "
            "indistinguishable from a healthy board. supertool 'channel:health'\n"
            % state_dir_could_not_check)

if accepted:
    raise SystemExit(0)

sys.stderr.write(
    "oss-workspace: the installed supertool will DISCARD the watch channel name %r "
    "(%d characters): it does not match %s, that version's own rule, read from %s. "
    "The name was exported anyway -- refusing it here would be this plugin carrying "
    "a copy of somebody else's rule -- so the consumer falls back to the SHARED "
    "DEFAULT socket, which is what this line exists to make visible. Shorten the "
    "derived name by declaring watch_name in an op block of this repo's "
    ".supertool.json. supertool 'channel:health'\n"
    % (name, len(name), pattern, rule_path))
ASK_CONSUMER
# ask_consumer_status was already captured by the `&&`/`||` on the heredoc
# opener above (#588) -- a second `=$?` here would capture the status of the
# ASSIGNMENT that just ran, which is always 0, and silently overwrite it.
if [ "$ask_consumer_status" -ne 0 ]; then
    # The block above crashed before reaching cannot_ask() itself -- an uncaught
    # RecursionError out of json.load on a deeply nested registry, say, which is
    # neither OSError nor ValueError and so escapes both guards inside the block.
    # The `|| true` this heredoc invocation used to end in swallowed exactly that:
    # a traceback already reached stderr, loud, but nothing then told this launcher
    # -- or anything reading its stderr -- that the probe had failed to ANSWER at
    # all, rather than having answered accepted or rejected. That is the third
    # state cannot_ask() exists to report, so route a crashed probe there too: the
    # crashed interpreter cannot name cannot_ask()'s own "why", only that it did
    # not finish, so this says that instead (#573).
    #
    # The name is rendered the same way cannot_ask() itself renders it -- via
    # Python's repr(), not interpolated raw -- for the same reason: this arm is
    # reachable with an UNVALIDATED name, because an already-exported
    # SUPERTOOL_WATCH_NAME wins and never goes through the gate (see the identical
    # comment on cannot_ask() a few dozen lines up). A raw `echo` here would let a
    # newline or a terminal escape sequence in that name reach this receipt
    # unescaped -- a forged line at column 0, or worse, exactly the harm the
    # sibling comment names. A second `$python_bin` call is a smaller exposure
    # than the crashed probe already took: this one only reprs an argv string, it
    # imports nothing.
    ask_consumer_name_repr=$("$python_bin" -c \
        'import sys; sys.stdout.write(repr(sys.argv[1]))' \
        "$SUPERTOOL_WATCH_NAME" 2>/dev/null) || ask_consumer_name_repr="<could not render>"
    # printf, not echo: this /bin/sh's echo builtin interprets backslash escapes
    # (XSI behaviour) even with no -e given, so an `echo` here would silently
    # UN-escape the very \n / \xNN sequences repr() just produced -- turning the
    # escaping above into a no-op and reproducing the exact forged-line risk it
    # exists to close. printf '%s\n' never reinterprets its %s argument.
    ask_consumer_message="oss-workspace: could not ask the installed supertool whether it will accept the watch channel name $ask_consumer_name_repr (${#SUPERTOOL_WATCH_NAME} characters) -- the probe crashed (exit status $ask_consumer_status) before it could answer. So this session is on a private socket or on the shared default one and nothing here can tell you which. supertool 'channel:health'"
    printf '%s\n' "$ask_consumer_message" >&2
fi
fi

# The consumer ships with the SUPERTOOL plugin, not with this one, and its path
# is resolved from installed_plugins.json rather than by globbing the cache: the
# cache keeps every version ever installed, so a glob answers with whichever
# sorts last and reports a version this session is not running. That exact bug
# shipped once in scripts/doctor.py.
channel_script=""
find_consumer_status=0
if [ -n "$python_bin" ]; then
# `&& find_consumer_status=0 || find_consumer_status=$?` on the assignment
# itself -- not a trailing `|| true` after the heredoc closes -- for the
# identical reason ASK_CONSUMER above captures its status the same way
# (#588): a bare simple command in an `if` BODY is exactly where `set -eu`
# (:31) applies, and the ORIGINAL `|| true` here swallowed both the exit
# status AND errexit's kill switch at once. A `RecursionError` out of
# `json.load` on a deeply nested (but validly-formed) registry is neither
# `OSError` nor `ValueError`, so it escapes the guard below, the
# interpreter exits nonzero, and `channel_script` is left empty with no
# signal that anything went wrong -- landing this crash in the exact same
# branch a genuine absence lands in below, and reporting the SAME
# confident "not found" sentence for two different facts about the world
# (#578). This is worse than the ASK_CONSUMER case #588 fixed: there the
# crash at least reached stderr as a traceback beside a wrong answer; here
# it reads as a specific, plausible sentence nobody has reason to doubt.
channel_script=$("$python_bin" - <<'FIND_CONSUMER'
import json, os, sys

# Each dead end names itself. "Not found" with no reason is the shape that
# reports a confident wrong answer -- an absent registry, a supertool that is not
# installed and an install path that no longer holds the consumer are three
# different problems with three different remedies, and one message for all three
# sends everybody to the wrong one.
registry = os.path.expanduser("~/.claude/plugins/installed_plugins.json")
try:
    with open(registry, encoding="utf-8") as handle:
        doc = json.load(handle)
except (OSError, ValueError) as err:
    sys.stderr.write("oss-workspace: %s could not be read (%s)\n" % (registry, type(err).__name__))
    raise SystemExit(0)

# Same guard as ASK_CONSUMER above (#546): a malformed registry must not reach an
# unhandled AttributeError -- this block's own comment already argues against a
# confident wrong answer, and a raw traceback is worse than that.
if not isinstance(doc, dict):
    sys.stderr.write("oss-workspace: %s is not a JSON object\n" % registry)
    raise SystemExit(0)

plugins = doc.get("plugins")
if plugins and not isinstance(plugins, dict):
    sys.stderr.write("oss-workspace: %s's \"plugins\" entry is not a JSON object\n" % registry)
    raise SystemExit(0)
if not isinstance(plugins, dict):
    plugins = {}

installs = []
malformed = ""
for key, entries in plugins.items():
    if key.split("@")[0] != "supertool":
        continue
    if entries and not isinstance(entries, list):
        malformed = "%s's supertool entry is not a JSON array" % registry
        continue
    for entry in (entries if isinstance(entries, list) else []):
        if not isinstance(entry, dict):
            malformed = "%s lists a supertool install entry that is not a JSON object" % registry
            continue
        if entry.get("installPath"):
            installs.append(entry.get("installPath"))

if not installs:
    sys.stderr.write(
        "oss-workspace: %s\n" % (
            malformed
            if malformed
            else "%s lists no supertool install, so the channel consumer it "
                 "ships has nowhere to be read from" % registry
        ))
    raise SystemExit(0)

for path in installs:
    candidate = os.path.join(path, "notifiers", "claude-channel", "channel.ts")
    if os.path.isfile(candidate):
        print(candidate)
        raise SystemExit(0)

sys.stderr.write(
    "oss-workspace: supertool is installed at %s but holds no "
    "notifiers/claude-channel/channel.ts\n" % ", ".join(installs))
FIND_CONSUMER
) && find_consumer_status=0 || find_consumer_status=$?
fi

# --- pre-registration plugin-population check: does an installed plugin's --
# own .mcp.json already provide a claude-channel consumer, in scope, BEFORE
# oss-channel is even considered? (#1307)
#
# Registering oss-channel unconditionally below and asking the #810 census
# afterward means that census counts THIS launcher's own just-added
# registration as a second consumer whenever a plugin already ships one --
# disarming the channel over the collision the launcher itself just created.
# `plugin_channel_arm_decision`, in
# scripts/doctor_check_mcp_channel_registration.py, is asked here, before
# the registration decision, over the exact in-scope population #1241's own
# `_plugin_channel_consumer_names` already derives for the census's plugin
# half.
plugin_channel_state=""
plugin_channel_target=""
plugin_channel_label=""
plugin_channel_names=""
plugin_channel_reason=""
if [ -n "$python_bin" ]; then
    plugin_channel_out=$("$python_bin" - "$plugin_root/scripts" "$repo_root" <<'PLUGIN_CHANNEL_PRECHECK'
import sys

sys.path.insert(0, sys.argv[1])
project_dir = sys.argv[2]

# `import doctor` FIRST -- the identical circular-import note CHANNEL_CENSUS
# gives further down: doctor_check_mcp_channel_registration's own top-level
# does `import doctor`, which imports names BACK out of it, so importing the
# submodule directly here first crashes before it can answer.
import doctor
import doctor_check_mcp_channel_registration as _channel_mod
import doctor_check_mcp_channel_connection as _live_mod

state, detail = _channel_mod.plugin_channel_arm_decision(project_dir=project_dir)
if state == "single":
    # #1361: `single` means a plugin DECLARES a consumer, not that the harness
    # starts one. When it does not -- disabled by the plugin, rejected by the
    # harness, a cached connect failure never retried -- declining to register
    # oss-channel here and arming against that name composes two correct
    # decisions into zero consumers, and nothing downstream reports it: the
    # census counts one configured server and calls it no collision. So the
    # decline is now conditional on the declared server actually being live.
    # `could-not-ask` deliberately keeps the old behaviour: an unread answer is
    # not evidence the declared consumer is dead, and registering a second
    # server on it recreates the exact collision #1307's decline exists to
    # avoid.
    _label, _resolvable = detail
    _live_state, _live_detail = _live_mod.arm_target_liveness(_resolvable)
    if _live_state == "failed":
        print("declared-but-not-live")
        print(_resolvable)
        print(str(_live_state) + ": " + " ".join(str(_live_detail).splitlines()))
        raise SystemExit(0)
print(state)
if state == "single":
    label, resolvable = detail
    print(label)
    print(resolvable)
elif state == "plural":
    for label in detail:
        print(label)
elif state == "could-not-ask":
    print(str(detail).replace("\n", " "))
PLUGIN_CHANNEL_PRECHECK
) && plugin_channel_status=0 || plugin_channel_status=$?
    if [ "$plugin_channel_status" -eq 0 ]; then
        # Parsed with the SAME printf | sed idiom the pre-existing #810
        # CHANNEL_CENSUS block below already uses (census_state/census_rest),
        # rather than a `while read` loop over an unquoted heredoc -- self-
        # review finding, reasoned rather than reproduced (no Windows
        # machine to hand): a `while IFS= read -r` loop reading an unquoted
        # `<<HEREDOC` body built from a command-substitution variable is a
        # parsing path nothing else in this file uses, while `printf '%s\n'
        # "$var" | sed -n 'Np'` is the exact idiom already proven, on
        # every CI platform including Windows, by CHANNEL_CENSUS's own
        # identical two-state extraction a few hundred lines below. Matching
        # it removes whatever novel platform-specific risk the read-loop
        # carried, without needing to first pin down what it was.
        plugin_channel_state=$(printf '%s\n' "$plugin_channel_out" | sed -n '1p')
        plugin_channel_rest=$(printf '%s\n' "$plugin_channel_out" | tail -n +2)
        case $plugin_channel_state in
            single)
                plugin_channel_label=$(printf '%s\n' "$plugin_channel_rest" | sed -n '1p')
                plugin_channel_target=$(printf '%s\n' "$plugin_channel_rest" | sed -n '2p')
                ;;
            plural)
                plugin_channel_names=$(printf '%s\n' "$plugin_channel_rest" | tr '\n' ',' | sed 's/,$//; s/,/, /g')
                ;;
            could-not-ask)
                plugin_channel_reason=$(printf '%s\n' "$plugin_channel_rest" | sed -n '1p')
                ;;
            declared-but-not-live)
                # #1361: exactly one installed plugin declares a claude-channel
                # consumer, and the harness does not have it live -- so arming
                # against it would open a session with no consumer at all,
                # while the decline below would suppress the one registration
                # that could still provide one. Falls through to the `else`
                # branch, which registers $CHANNEL_SERVER as it did before
                # #1307 -- correct here precisely because the declared server
                # is not holding the socket.
                plugin_channel_target=$(printf '%s\n' "$plugin_channel_rest" | sed -n '1p')
                plugin_channel_reason=$(printf '%s\n' "$plugin_channel_rest" | sed -n '2p')
                echo "oss-workspace: an installed plugin declares the" \
                     "claude-channel consumer ($plugin_channel_target) but the" \
                     "harness does not have it live ($plugin_channel_reason)," \
                     "so arming against it would open a session with no" \
                     "consumer. Registering $CHANNEL_SERVER instead; the #810" \
                     "census below still decides." >&2
                plugin_channel_target=""
                ;;
        esac
        # The check RAN (exit 0) but could not establish the plugin
        # population itself -- an unreadable or malformed
        # installed_plugins.json, or one installed plugin's own unreadable
        # .mcp.json (#1307 self-review finding: this state was parsed above
        # but never reported, so it read identically to `none` on stderr --
        # the exact absence-produced-by-the-tool this plugin is about,
        # reproduced inside the fix for a different instance of it). Never
        # silently treated as `none`: that would stop registering
        # oss-channel's would-be plugin replacement when the only reason it
        # looks absent is that the check could not look.
        if [ "$plugin_channel_state" = "could-not-ask" ]; then
            echo "oss-workspace: could not determine whether an installed" \
                 "plugin already provides a claude-channel consumer for this" \
                 "repo: $plugin_channel_reason. Registering $CHANNEL_SERVER" \
                 "as usual; the #810 census below still decides." >&2
        fi
    else
        plugin_channel_state=""
        echo "oss-workspace: could not determine whether an installed plugin" \
             "already provides a claude-channel consumer for this repo (the" \
             "check crashed, exit status $plugin_channel_status). Registering" \
             "$CHANNEL_SERVER as usual; the #810 census below still decides." >&2
    fi
fi

# `claude mcp get` answers 0 for any CONFIGURED server, whether or not the file it
# names still exists -- measured against claude 2.1.219, an entry pointing at a
# deleted script gets exit 0 and a "Failed to connect" status. So presence is not
# readiness. The path `claude mcp add` stores is absolute and version-pinned,
# because it is the installPath out of installed_plugins.json, and the plugin cache
# drops the old version directory on auto-update: the registration outlives the
# file, the flag is still passed, the resolver is still satisfied, and bun starts
# nothing. That is the armed-and-delivering-nothing state this script's header is
# about, so where the registration points is read and compared.
#
# It is read out of `claude mcp get`'s own output rather than out of ~/.claude.json:
# the config file's project keys are realpath'd and its layout is nobody's contract,
# while `get` is the public way to ask. For a local-scope stdio entry it prints
#
#     Type: stdio
#     Command: bun
#     Args: /abs/path/to/channel.ts
#
# That shape is not a contract either -- the same command prints no Command/Args at
# all for a project-scope entry -- which is why failing to find those lines is its
# own reported state below and not a silent pass.
#
# `channel_ready` is initialised ONCE here, before the whole if/elif/else below,
# rather than inside each arm separately (#1343): the `plural` arm never set it at
# all -- it relied on this exact initialisation existing, which it did not -- so
# under `set -eu` the later `[ "$channel_ready" -eq 1 ]` read killed the launcher
# with "channel_ready: unbound variable" before it ever reached `exec claude`,
# directly contradicting this file's own stated rule that a session with no
# channel beats no session.
#
# Deliberately NOT the bare line `channel_ready=0` on its own -- that exact
# text is a marker `tests/test_find_consumer_578.py`'s `_extract_block`
# searches for (`DECIDE_START`) to isolate the LATER, unrelated mcp-get-based
# decision chain a few hundred lines down. A second bare occurrence here
# would make `str.find` match THIS line first and extract from here through
# that chain's own closing `fi` -- the whole single/plural/else block in
# between, referencing variables the test's synthetic harness never sets.
channel_ready=0  # #1343: default before the whole single/plural/else decision

# #1343: the `single` state below is a NAME `plugin_channel_arm_decision` reports
# from a plugin's own `.mcp.json`, not a registration `claude mcp` has confirmed --
# every OTHER arm in this file (the oss-channel registration a few lines down, the
# #810 census) verifies via `claude mcp get`/`claude mcp list` before trusting a
# name, and this one alone did not. A plugin that reports a consumer `claude` does
# not actually know about must fall back to registering $CHANNEL_SERVER from
# scratch rather than arm a name the launch will then refuse outright.
if [ "$plugin_channel_state" = "single" ] \
   && ! claude mcp get "$plugin_channel_target" >/dev/null 2>&1; then
    echo "oss-workspace: $plugin_channel_target ($plugin_channel_label in the" \
         "#810 census) was named as the claude-channel consumer for this repo," \
         "but claude mcp get $plugin_channel_target could not verify it." \
         "Falling back to registering $CHANNEL_SERVER instead of trusting an" \
         "unverified name." >&2
    plugin_channel_state="single-unverified"
    # `channel_arm_server`, far below, arms against `$plugin_channel_target`
    # whenever it is non-empty, independent of `$plugin_channel_state` -- so an
    # unverified target left in place here would still get armed at the very
    # end even though this fallback just chose NOT to trust it and registered
    # $CHANNEL_SERVER instead.
    plugin_channel_target=""
fi

if [ "$plugin_channel_state" = "single" ]; then
    # An installed plugin's own .mcp.json already provides the one in-scope
    # claude-channel consumer for this repo
    # (scripts/doctor_check_mcp_channel_registration.py's
    # `plugin_channel_arm_decision`, asked above, before this registration
    # decision) -- registering oss-channel on top of it is exactly #1307's
    # own collision: the #810 census below would then count two and refuse
    # to arm over the one this launcher just added. Arm against the
    # plugin's own server instead; oss-channel is never registered in this
    # branch.
    channel_registered=0
    if channel_entry=$(claude mcp get "$CHANNEL_SERVER" 2>/dev/null); then
        channel_registered=1
    fi
    if [ "$channel_registered" -eq 1 ]; then
        # A stale oss-channel left behind by an earlier launcher version is
        # registered at LOCAL scope only -- the one scope this launcher
        # itself ever writes to (see the remove-and-add a few lines below,
        # in the else branch) -- so it is this launcher's own past
        # registration to clean up, not a maintainer's config to leave
        # alone. Left in place, it would keep the #810 census counting two
        # servers (itself plus the plugin consumer) on EVERY future launch,
        # forever, with no configuration a maintainer could write to clear
        # it -- the exact permanently-disarmed state #1307 reports,
        # reproduced for a different reason. Reporting it instead of
        # removing it was considered and declined: a report with no
        # corresponding write leaves the channel disarmed on every launch
        # from here on, which is the bug this fix exists to close, not a
        # softer version of fixing it.
        if claude mcp remove "$CHANNEL_SERVER" -s local >/dev/null 2>&1; then
            echo "oss-workspace: removed the stale MCP server $CHANNEL_SERVER" \
                 "(local scope) -- $plugin_channel_target already provides" \
                 "the claude-channel consumer for this repo, and leaving" \
                 "$CHANNEL_SERVER registered would keep the pre-launch" \
                 "census counting two servers forever." >&2
        else
            echo "oss-workspace: $CHANNEL_SERVER is registered but could not" \
                 "be removed, so the pre-launch census below will still see" \
                 "two servers. Run claude mcp remove $CHANNEL_SERVER -s local" \
                 "by hand." >&2
        fi
    fi
    channel_ready=1
    # #1432: this used to relay to `scripts/doctor.py`'s own registration
    # check via `OSS_WORKSPACE_CHANNEL_ARM_TARGET`, back when that check ran
    # SYNCHRONOUSLY from this file, in this same process. #1392 moved that
    # `doctor.sh` invocation into the session's own `/oss:run` step 1 instead
    # -- a separate process, started well after this script (and the relay it
    # would have exported) has already exited, so nothing has ever been able
    # to read it since. `$plugin_channel_target` still decides what THIS
    # launch arms against, below (`channel_arm_server`); only the dead export
    # is gone.
    # `$plugin_channel_label` is the #810/#1241 census's OWN reporting form
    # of the same server (the installed-plugin registry's un-stripped
    # `<name>@<marketplace>` key) -- named here too, alongside the resolved
    # `$plugin_channel_target` this session actually arms against, so a
    # maintainer cross-referencing this line with a `channel MCP consumer
    # census` WARN elsewhere (which only ever prints the label form) can
    # tell the two are the same server.
    echo "oss-workspace: $plugin_channel_target ($plugin_channel_label in" \
         "the #810 census) already provides the claude-channel consumer" \
         "for this repo (declared by an installed plugin's own .mcp.json)" \
         "-- arming the channel flag against it instead of registering" \
         "$CHANNEL_SERVER." >&2
elif [ "$plugin_channel_state" = "plural" ]; then
    # Two or more installed plugins already collide with each other before
    # oss-channel is even in the picture -- registering a third racer on
    # top would only make it worse. Left unregistered; the session opens
    # without the flag, the same "a board that cannot be verified is not a
    # board that is armed" call the arms below already make. `channel_ready`
    # is already 0 here -- initialised once, above, before this whole
    # if/elif/else (see that comment for why it is not repeated here).
    echo "oss-workspace: more than one installed plugin already provides a" \
         "claude-channel consumer for this repo ($plugin_channel_names) --" \
         "$CHANNEL_SERVER was not registered on top of them. Opening" \
         "WITHOUT the channel flag; deleting or editing whichever plugin" \
         "config declared the extra one is not this launcher's call to" \
         "make." >&2
else

channel_registered=0
registered_command=""
registered_args=""
# #1432: `channel_entry` (and, until a shellcheck SC2034 fix on the same
# lane, a captured `mcp_get_status`) used to be exported here too
# (`OSS_WORKSPACE_MCP_CHECKED`/`_STATUS`/`_OUTPUT`), so `scripts/doctor.py`'s
# own registration check could read this answer instead of shelling out to
# `claude mcp get` a second time in the same session-open (#629: `claude` is
# not cheap to start). That check now runs from inside the session's own
# `/oss:run` step 1 (#1392 moved the `doctor.sh` invocation there) -- a
# separate process, started after this one has already exited, so the export
# has had no reachable reader since. `channel_registered`/`registered_command`/
# `registered_args` below are this script's OWN plain shell variables, read
# directly a few lines down for this launch's own arming decision; the exit
# status itself is not one of them -- nothing here ever branched on it once
# the export was gone, so it is not captured any more either.
if channel_entry=$(claude mcp get "$CHANNEL_SERVER" 2>/dev/null); then
    channel_registered=1
    # `[ \t]` rather than a POSIX character class: a class inside an awk program
    # still writes a doubled bracket into the file, and the guard that keeps this
    # script out of bash test syntax matches on the characters, not on the context.
    # The trailing sub also eats a CR, because Git Bash reading a Windows-built
    # claude's output is where that difference shows up.
    registered_command=$(printf '%s\n' "$channel_entry" | awk '/^[ \t]*Command:/ { sub(/^[ \t]*Command:[ \t]*/, ""); sub(/[ \t\r]+$/, ""); print; exit }')
    registered_args=$(printf '%s\n' "$channel_entry" | awk '/^[ \t]*Args:/ { sub(/^[ \t]*Args:[ \t]*/, ""); sub(/[ \t\r]+$/, ""); print; exit }')
fi

channel_ready=0
if [ "$find_consumer_status" -ne 0 ]; then
    # The third state, separate from both branches below: those two report what
    # the probe FOUND (nothing, or a registration it could not verify); this one
    # reports that the probe never got to answer at all -- crashed (#578), the
    # same distinction ASK_CONSUMER's own "could not ask" arm draws for its call
    # site. Checked first because a crash also leaves channel_script empty, which
    # would otherwise fall into the plain "not found" sentence below and read as
    # a specific, plausible fact about the world rather than as "unknown."
    echo "oss-workspace: could not determine whether the supertool plugin's" \
         "channel consumer is installed: the probe that looks for it in" \
         "installed_plugins.json crashed (exit status $find_consumer_status)" \
         "before it could answer, so whether it exists is UNKNOWN rather than" \
         "absent. Opening WITHOUT the channel flag: supertool 'channel:health'" >&2
elif [ -z "$channel_script" ] && [ "$channel_registered" -eq 1 ]; then
    # The third state: a registration exists and there is nothing to compare it
    # against. Blaming a missing consumer here would send someone to reinstall a
    # plugin that is installed; what failed is the reading, not the install.
    echo "oss-workspace: MCP server $CHANNEL_SERVER is registered, but the consumer" \
         "path could not be resolved here, so whether that registration still points" \
         "at a file that exists cannot be checked. Opening WITHOUT the channel flag:" \
         "a board that cannot be verified is not a board that is armed." >&2
elif [ -z "$channel_script" ]; then
    echo "oss-workspace: the supertool plugin's channel consumer was not found in" \
         "installed_plugins.json, so this session opens WITHOUT the channel flag." \
         "Naming an unregistered server refuses the launch outright, which is worse" \
         "than a session with no board." >&2
elif ! command -v bun >/dev/null 2>&1; then
    echo "oss-workspace: bun is not on PATH, so the channel consumer cannot start." \
         "Opening without the channel flag." >&2
elif [ "$channel_registered" -eq 1 ] && [ -z "$registered_args" ]; then
    echo "oss-workspace: MCP server $CHANNEL_SERVER is registered, but no Command or" \
         "Args line could be read out of 'claude mcp get $CHANNEL_SERVER', so where" \
         "it points is unknown and cannot be compared with $channel_script. Opening" \
         "WITHOUT the channel flag rather than trusting it. Run" \
         "claude mcp remove $CHANNEL_SERVER -s local and start again to have it" \
         "registered from scratch." >&2
elif [ "$channel_registered" -eq 1 ] \
     && [ "$registered_command" = "bun" ] \
     && [ "$registered_args" = "$channel_script" ]; then
    # Registered at LOCAL scope rather than passed as `--mcp-config`: a server
    # loaded from --mcp-config does start and does bind the socket, but the
    # channel resolver reads CONFIGURED servers only and refuses it by name. Local
    # scope is per-project and private, so it does not ship, and the path is
    # absolute so it cannot depend on CLAUDE_PLUGIN_ROOT being set.
    #
    # Still idempotent, now on the value rather than on the key: an entry that
    # already names this consumer is left alone, because a remove-and-add on every
    # launch churns the user's config for nothing.
    channel_ready=1
else
    # `claude mcp add` refuses a name that is already taken -- "MCP server
    # oss-channel already exists in local config", exit 1 -- rather than replacing
    # it, so a re-point is a remove followed by an add. The remove is allowed to
    # fail: `get` resolves across scopes, so an entry someone put at project or user
    # scope is found here and is NOT ours to delete at local scope. If the add then
    # collides with it, that lands in the failure branch below and this session opens
    # without the flag -- which is the honest answer to a name we do not own.
    if [ "$channel_registered" -eq 1 ]; then
        claude mcp remove "$CHANNEL_SERVER" -s local >/dev/null 2>&1 || true
    fi
    if claude mcp add -s local "$CHANNEL_SERVER" bun "$channel_script" >/dev/null 2>&1; then
        channel_ready=1
        if [ "$channel_registered" -eq 1 ]; then
            echo "oss-workspace: MCP server $CHANNEL_SERVER pointed at" \
                 "$registered_command $registered_args, which is not the consumer this" \
                 "session resolved, so it was re-pointed at bun $channel_script. A" \
                 "version-pinned path outlives the cache directory it names, and a" \
                 "registration that survives its file is a channel that delivers" \
                 "nothing. Remove it with claude mcp remove $CHANNEL_SERVER -s local" >&2
        else
            echo "oss-workspace: registered MCP server $CHANNEL_SERVER at local scope" \
                 "(private to $repo_root) pointing at $channel_script. Remove it with" \
                 "claude mcp remove $CHANNEL_SERVER -s local" >&2
        fi
    else
        echo "oss-workspace: could not register the MCP server $CHANNEL_SERVER, so" \
             "this session has no channel consumer. Opening without the flag;" \
             "supertool 'channel:health' says the same from inside." >&2
    fi
fi

fi

# --- pre-launch channel-consumer census: anything ELSE racing for the socket? (#810) --
#
# Every arm above verifies THIS session's own oss-channel registration and stops
# there -- it has nothing to say about whether some OTHER configured MCP server
# (a stray project .mcp.json, a local-scope entry from an earlier experiment)
# ALSO resolves to notifiers/claude-channel/channel.ts, the one script every
# claude-channel server runs. Two servers racing that script for one Unix socket
# is invisible from inside a session: one binds, the other is silently refused,
# and channel:health can only report CANNOT DETERMINE. This is the only place the
# collision is both visible (claude mcp list enumerates every configured server,
# whichever file declared it) and avoidable (before the flag that starts the race
# is armed) -- "a board that cannot be verified is not a board that is armed" is
# the same reasoning the arms above already use, on the same subject one layer
# out.
#
# `channel_consumer_census_state` -- the exact function
# scripts/doctor_check_mcp_channel_registration.py's own `/oss:doctor` mirror
# calls (#810's own step 3) -- is called HERE too, rather than this launcher
# running `claude mcp list` a second time and parsing it separately: two
# independent parsers of the same prose is how a launcher and a diagnostic end
# up disagreeing about a count neither of them is wrong about on its own terms.
#
# Only worth asking when the flag is about to be armed: a session that already
# opens WITHOUT it has nothing this census could take away.
if [ "$channel_ready" -eq 1 ]; then
    if [ -z "$python_bin" ]; then
        channel_ready=0
        echo "oss-workspace: no working python was found, so whether a second" \
             "MCP server also resolves to the claude-channel consumer script" \
             "could not be checked. Opening WITHOUT the channel flag." >&2
    else
        # #1361: ask `claude mcp list` ONCE, here, and relay the raw answer to
        # the census heredoc a few lines below, in THIS SAME process -- not to
        # doctor's own connection check any more (#1432): that relied on
        # `OSS_WORKSPACE_MCP_LIST_CHECKED` reaching a later, separate
        # `doctor.sh` process this file used to run synchronously, which #1392
        # moved into the session's own `/oss:run` step 1 instead. That sentinel
        # is dropped -- nothing has read it since -- but `OSS_WORKSPACE_MCP_
        # LIST_OUTPUT` itself stays: it is what lets the embedded python census
        # below reuse this one `claude mcp list` call instead of asking again,
        # which is the actual saving #1361 measured (~1.3s per extra start). A
        # failed or unavailable ask exports nothing, so the census falls
        # through to its own ask rather than reading an empty relay as an
        # empty listing.
        if mcp_list_output=$(claude mcp list 2>&1); then
            export OSS_WORKSPACE_MCP_LIST_OUTPUT="$mcp_list_output"
        else
            # #1378 (gate 3 round two, v0.31.0): a failed ask must still
            # OVERWRITE this name in THIS process's own environment, never
            # merely skip setting it. An inherited value -- a parent shell's
            # profile, or a caller that exported this same name before
            # invoking this launcher -- would otherwise survive untouched and
            # be replayed to the census heredoc below as though it were a
            # fresh answer from this launch. That heredoc has no way to tell
            # "computed here, just now" from "inherited, arbitrarily stale",
            # so the guarantee has to be made here: whatever this launch's
            # own ask produced -- succeeded or failed -- is what this name
            # holds, every time.
            export OSS_WORKSPACE_MCP_LIST_OUTPUT=""
        fi
        census_report=$("$python_bin" - "$plugin_root/scripts" "$repo_root" <<'CHANNEL_CENSUS'
import sys

sys.path.insert(0, sys.argv[1])
project_dir = sys.argv[2]
# `import doctor` FIRST, never `import doctor_check_mcp_channel_registration`
# directly -- that module's own top-level does `import doctor`, which in turn
# imports names BACK out of it (the re-export convention every moved check in
# this family uses). Importing it first here, mid-initialisation, is a
# circular import: `doctor`'s own `from doctor_check_mcp_channel_registration
# import (...)` runs while this module's later names have not been defined yet,
# and the whole call crashes before it can answer anything.
import doctor

# `project_dir` scopes the plugin-population half the same way
# `plugin_channel_arm_decision` above already scopes it (#1307 self-review
# finding): called with no project_dir at all, `_entry_in_scope` treats
# EVERY project/local-scoped row across every repo this machine ever
# installed a plugin into as in scope, so an unrelated project's own
# claude-channel consumer could report a false collision here and disarm a
# channel that has nothing racing it in THIS repo.
# #1361: `claude mcp list` is asked ONCE here and its output handed to both
# readers, rather than each calling it for itself. The census below needs the
# names; doctor's own connection check needs the connection statuses on the
# same rows, and `test_the_launcher_relays_its_own_census_to_doctor_sh_rather_
# than_asking_twice` counts the calls a whole launch makes. `claude` is not a
# cheap binary to start, and this is the identical economy #629 and #810
# already applied to the two asks either side of it.
import os

_list_text = os.environ.get("OSS_WORKSPACE_MCP_LIST_OUTPUT", "")
_claude = "claude"


def _replay(argv, **kwargs):
    """The captured answer, replayed to a reader that would otherwise ask."""

    class _Completed(object):
        returncode = 0
        stdout = _list_text

    return _Completed()


state, detail = doctor.channel_consumer_census_state(
    project_dir=project_dir,
    run=_replay if _list_text else None,
    which=(lambda _n: _claude) if _list_text else None,
)
print(state)
if state == "collision":
    for name in detail:
        print(name)
elif state == "could-not-ask":
    print(str(detail).replace("\n", " "))
CHANNEL_CENSUS
) && census_parse_status=0 || census_parse_status=$?
        if [ "$census_parse_status" -ne 0 ]; then
            channel_ready=0
            echo "oss-workspace: could not determine whether a second MCP server" \
                 "also resolves to the claude-channel consumer script (the" \
                 "census check crashed, exit status $census_parse_status)." \
                 "Opening WITHOUT the channel flag." >&2
        else
            # #1432: `census_report` used to be relayed here too
            # (`OSS_WORKSPACE_CENSUS_CHECKED`/`_REPORT`) to doctor.sh's own
            # #810 census check, run from inside the session's own /oss:run
            # rather than from this file (#1392 moved that invocation there) --
            # a separate process that starts after this one has already
            # exited, so the relay has had nothing to reach since. This
            # script's own `census_state`/`census_rest` below, parsed straight
            # out of `$census_report`, are what THIS launch's own arm/disarm
            # decision actually reads; only the env export to an unreachable
            # later reader is gone.
            census_state=$(printf '%s\n' "$census_report" | head -n1)
            census_rest=$(printf '%s\n' "$census_report" | tail -n +2)
            case $census_state in
                single|none) ;;
                could-not-ask)
                    channel_ready=0
                    echo "oss-workspace: could not tell whether a second MCP" \
                         "server also resolves to the claude-channel consumer" \
                         "script: $census_rest -- never read as \"exactly one" \
                         "server\". Opening WITHOUT the channel flag: a board" \
                         "that cannot be verified is not a board that is" \
                         "armed." >&2
                    ;;
                collision)
                    channel_ready=0
                    census_names_joined=$(printf '%s\n' "$census_rest" | tr '\n' ',' | sed 's/,$//; s/,/, /g')
                    echo "oss-workspace: more than one configured MCP server" \
                         "resolves to notifiers/claude-channel/channel.ts" \
                         "($census_names_joined) -- a session opened with the" \
                         "channel flag would race them for one socket, and one" \
                         "is silently refused. Opening WITHOUT the channel" \
                         "flag; deleting or editing whichever config declared" \
                         "the extra one is not this launcher's call to make." >&2
                    ;;
                *)
                    channel_ready=0
                    echo "oss-workspace: the channel-consumer census reported a" \
                         "state this launcher does not recognise" \
                         "($census_state), so whether a second MCP server also" \
                         "resolves to the claude-channel consumer script is" \
                         "UNKNOWN. Opening WITHOUT the channel flag." >&2
                    ;;
            esac
        fi
    fi
fi

# --- plugin identity: did it change since the last session here? (#626) -------
#
# `commands/tick.md` step 1 already compares this tick's plugin identity
# against the last one recorded (#477) -- but only the dispatch cadence
# `/oss:run` falls through to when nothing more urgent is due reaches that
# step (#1392: `/oss:run` is what every session now opens with, and it may
# never reach `tick.md`'s own procedure at all on a given launch). A QA
# session, a review, or an ordinary working session never does either, and
# those are exactly the sessions that carry a stale environmental picture: an
# earlier session's command text against a later session's registry. The
# `/oss:run` session about to open runs `scripts/doctor.py` over THIS REPO on
# its own first turn (#1390), and "oss plugin version X" is one line inside
# its many findings -- printed only when the overall VERDICT is not `ok`, and
# a version change is not itself a failure there, so it is routinely
# swallowed by a healthy VERDICT and never said loudly.
#
# The prior lives in a file of its own rather than in `<state_file>`, the
# per-repo path named in `.oss.local.json`: that file will not exist yet on
# the very first launch after a clone (#1392: every launch opens the same
# `/oss:run`, whether or not `.oss.json` exists yet -- probing and writing one
# is `/oss:run`'s own first decision now, not a fact this launcher branches
# on), and the plugin's identity is a fact about this MACHINE's install, not
# about any one repo -- one file serves every repo this launcher opens, the
# same way the launcher itself is one binary symlinked in front of all of
# them.
#
# The read stays fast on purpose: `doctor.plugin_identity()` alone -- a
# manifest read plus a tree digest over the PLUGIN's own checkout -- never the
# full diagnostic below, which also reaches the network for dependency
# versions with a 25s timeout each.
# `${HOME:-}`, not a bare `$HOME`: `${XDG_CACHE_HOME:-$HOME/.cache}` only
# evaluates its fallback when XDG_CACHE_HOME is unset, and on a machine that
# sets NEITHER, that fallback is exactly the branch taken -- so a bare `$HOME`
# there aborts this line under `set -u` with "HOME: unbound variable", before
# the guard below ever gets a chance to say so.
plugin_identity_file="${XDG_CACHE_HOME:-${HOME:-}/.cache}/oss-workspace/last-plugin-identity"
if [ -z "${XDG_CACHE_HOME:-}" ] && [ -z "${HOME:-}" ]; then
    echo "oss-workspace: neither XDG_CACHE_HOME nor HOME is set, so whether the oss plugin changed since the last session here could not be told." >&2
elif [ -z "$python_bin" ]; then
    echo "oss-workspace: no working python was found, so whether the oss plugin changed since the last session here could not be told." >&2
else
    # Same idiom as ASK_CONSUMER above and for the same reason (#588): the
    # status capture is attached to the heredoc's own opener line, not to a
    # line after it, because `set -eu` kills the script at a crashed probe
    # before a later line ever runs.
    plugin_identity_current=$("$python_bin" - "$plugin_root" "$plugin_identity_file" <<'PLUGIN_IDENTITY'
import os
import sys

plugin_root, prior_path = sys.argv[1], sys.argv[2]
sys.path.insert(0, os.path.join(plugin_root, "scripts"))
try:
    import doctor
except Exception as err:
    sys.stderr.write(
        "oss-workspace: doctor.py could not be imported (%s), so whether the oss "
        "plugin changed since the last session here could not be told.\n"
        % type(err).__name__
    )
    raise SystemExit(1)

try:
    current = doctor.plugin_identity(plugin_root)
except Exception as err:
    sys.stderr.write(
        "oss-workspace: the plugin identity could not be read (%s), so whether it "
        "changed since the last session here could not be told.\n"
        % type(err).__name__
    )
    raise SystemExit(1)

try:
    with open(prior_path, encoding="utf-8") as handle:
        prior = handle.read().strip()
except FileNotFoundError:
    prior = None
except OSError as err:
    sys.stderr.write(
        "oss-workspace: %s could not be read (%s), so whether the oss plugin "
        "changed since the last session here could not be told.\n"
        % (prior_path, type(err).__name__)
    )
    raise SystemExit(1)

if prior is None:
    # Said once, never rendered as `unchanged` -- the ordinary state on the
    # very first launch after this file itself first shipped, and every bit
    # as much "could not tell" as the exception arms above, which already
    # explain themselves on stderr. This one has nothing to explain beyond
    # "there is no prior yet", so it says exactly that rather than leaving
    # the case statement below silent for a state its own comment claims is
    # already announced.
    sys.stderr.write(
        "oss-workspace: no prior oss plugin identity is recorded at %s, so "
        "whether it changed since the last session here is unknown. Normal "
        "on the first launch this ran; recorded now for the next one.\n"
        % prior_path
    )
    print("could-not-tell")
elif prior == current:
    print("unchanged")
else:
    print("changed %s -> %s" % (prior, current))

# Recorded regardless of the state above -- a failed write here is a gap in
# NEXT session's comparison, never in this one's, so it is announced rather
# than raised.
try:
    os.makedirs(os.path.dirname(prior_path), exist_ok=True)
    with open(prior_path, "w", encoding="utf-8") as handle:
        handle.write(current)
except OSError as err:
    sys.stderr.write(
        "oss-workspace: %s could not be written (%s), so this session's plugin "
        "identity will not be there for the next one to compare against.\n"
        % (prior_path, type(err).__name__)
    )
PLUGIN_IDENTITY
) || plugin_identity_current="could-not-tell"
    case $plugin_identity_current in
        unchanged) ;;
        could-not-tell*) ;;  # already announced above, on stderr
        changed*)
            plugin_identity_change=${plugin_identity_current#changed }
            echo "oss-workspace: the oss plugin changed since your last session here ($plugin_identity_change). Every environmental fact an earlier session established under the old version -- command text, the report schema, the rules layer -- may be stale in THAT session; this one starts fresh." >&2
            ;;
        *)
            # A shape neither this shell nor its own contract expects -- the same
            # unheard-of-verdict caution the doctor block below takes with its own
            # comparison, rather than silently treating it as `unchanged`.
            echo "oss-workspace: the plugin-identity comparison printed something this launcher does not recognise (${plugin_identity_current}), so whether the oss plugin changed since the last session here is UNKNOWN." >&2
            ;;
    esac
fi

# #1392: the pre-launch setup diagnostic and the #1155 threshold routes both
# used to live here, deciding which prompt to open with from the outside.
# Both dissolve into /oss:run (#1389, #1390): it diagnoses on every start,
# repairs what is ours, reports what is not, and decides for itself whether
# release, curate or triage is due before falling through to the ordinary
# dispatch cadence. A launcher-side copy of either check would be exactly
# the second copy of a fact this project's governing rule forbids.

# #1432: `OSS_WORKSPACE_MCP_CHECKED`/`_STATUS`/`_OUTPUT` (#629),
# `OSS_WORKSPACE_CENSUS_CHECKED`/`_REPORT` (#810) and
# `OSS_WORKSPACE_CHANNEL_ARM_TARGET` (#1307) are gone from this file entirely
# now, not merely unset here -- their one intended reader was this file's own
# synchronous `doctor.sh` call, which #1392 removed; nothing has been able to
# reach any of the three since, so there was nothing left to protect from
# staleness by unsetting again. `OSS_WORKSPACE_MCP_LIST_OUTPUT` is the one
# survivor in this family: it still has a real, same-process consumer (the
# #1361 census heredoc above), so it still needs unsetting here for the
# ordinary reason -- left exported, a session that inherited it would read a
# launch-time `claude mcp list` answer as though it were still current for the
# rest of the session, the stale-reading trap this repo is named after (see
# `statusline.py`'s cache history). Its own sentinel,
# `OSS_WORKSPACE_MCP_LIST_CHECKED`, is dropped along with the other three: it
# was read only by the same now-unreachable session-side `doctor.sh` check.
unset OSS_WORKSPACE_MCP_LIST_OUTPUT

# #1307: which name to arm the channel flag against. `oss-channel` unless the
# plugin-population precheck above found exactly one in-scope plugin-provided
# consumer and set `plugin_channel_target` to the name that actually resolves
# ($CHANNEL_SERVER was never registered in that branch, so arming against it
# here would refuse the launch outright with "no MCP server configured with
# that name").
channel_arm_server=$CHANNEL_SERVER
if [ -n "$plugin_channel_target" ]; then
    channel_arm_server=$plugin_channel_target
fi

# The last two lines of the progression. `channel_ready` is the one fact the
# whole channel section above resolves to, so it is what the line reports;
# the prose on stderr above it already said why when it is 0.
if [ "$channel_ready" -eq 1 ]; then
    oss_step channel "$channel_arm_server armed" ok
else
    oss_step channel "opening without a channel (see above)" skip
fi
if [ "$#" -eq 0 ]; then
    oss_step session "opening $prompt" go
else
    oss_step session "opening with your arguments, $prompt not appended" go
fi
[ "${oss_steps:-0}" -eq 1 ] && printf '\n  %sthe loop is yours%s\n\n' "$w" "$r"

if [ "$#" -eq 0 ]; then
    # The prompt goes FIRST and the variadic flag LAST. A positional after the
    # flag is read as one of its values, and claude refuses the launch rather than
    # dropping it.
    if [ "$channel_ready" -eq 1 ]; then
        exec claude "$prompt" "$CHANNEL_FLAG" "server:$channel_arm_server"
    fi
    exec claude "$prompt"
fi

# The third state. Placing our prompt after the caller's arguments hands `claude`
# a word it throws away; placing it first throws away the caller's own prompt.
# Neither is worth doing quietly, so it is not appended and the reason is stated.
echo "oss-workspace: arguments were passed through, so $prompt was NOT appended —" \
     "claude reads only its first positional as the prompt. Run $prompt inside the" \
     "session, or start it with no arguments." >&2

# The flag trails for the same reason it does above, and it terminates any
# variadic option the caller passed, being `-`-prefixed.
if [ "$channel_ready" -eq 1 ]; then
    exec claude "$@" "$CHANNEL_FLAG" "server:$channel_arm_server"
fi
exec claude "$@"
