__pycache__/
*.pyc
.coverage
.pytest_cache/
.DS_Store
.max/
.remember/
.oss.local.json

# Machine-specific symlink to the local claude-supertool clone.
/supertool

# The shell CI leg's file list, written by scripts/shell_sources.py into the workspace.
# A CI-only artifact, but the same command run by hand leaves it in the checkout.
/shell-sources.txt

# The owned copies this plugin writes INTO a managed repo. In every other repo they are
# tracked -- CI checks out the repo and nothing else, so the assembler has to be there.
# Here they would be a second copy of files this repo already carries under scripts/,
# swept by the same guards and free to drift from the originals (#479).
#
# Because of that, this repo's own .claude/settings.json must NOT use scaffold's usual
# statusLine default of .oss/statusline.py -- that path is gitignored here, so a fresh
# clone would get a statusLine pointing at a file nobody checked in (#496). This repo's
# own settings.json is re-pointed at scripts/statusline.py instead, which is tracked.
/.oss/

# Machine-local jit-context discovery logs: one checkout's session history,
# never part of the plugin. Swept into the v0.3.0 release commit by a `git
# commit --all` and removed in the same release.
.claude/jit-context/.discovery/

# A machine-local MCP server registration -- this repo's history carried one
# naming `claude-channel` with an absolute path into one person's own clone of
# claude-supertool, excluded only in that one clone's .git/info/exclude, which
# is invisible to every other checkout (#610). bin/oss-workspace already
# registers the same consumer PORTABLY, at local scope, resolved from the
# installed supertool plugin rather than from a checkout -- so this repo does
# not need a tracked .mcp.json the way claude-supertool's own repo does
# (${CLAUDE_PLUGIN_ROOT} resolves to THIS plugin's root here, which ships no
# notifier). This rule exists so a future one-off `.mcp.json`, for whatever
# local reason, never becomes committable just because it lands on a clone
# nobody has touched .git/info/exclude in -- it is not a claim that one is
# needed.
.mcp.json
.venv/
