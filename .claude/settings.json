{
  "enabledPlugins": {
    "oss@dpt-plugins": true,
    "supertool@dpt-plugins": true,
    "remember@dpt-plugins": true,
    "claude-jit-context@dpt-plugins": true
  },
  "statusLine": {
    "type": "command",
    "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/statusline.py"
  },
  "permissions": {
    "allow": [
      "Bash(supertool:*)",
      "Bash(./supertool:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(git mv:*)",
      "Bash(git checkout:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree remove:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -r:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-remote:*)",
      "Bash(git ls-files:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(git remote:*)",
      "Bash(git describe:*)",
      "Bash(git grep:*)",
      "Bash(git tag:*)",
      "Agent"
    ]
  }
}
