{
  "repo": "Digital-Process-Tools/claude-oss",
  "default_branch": "main",
  "branch_pattern": "fix/{issue}",
  "test_command": "pytest",
  "test_measurement_configured": true,
  "version_sites": [
    ".claude-plugin/plugin.json",
    "CHANGELOG.md",
    "README.md",
    "skills/manager/SKILL.md"
  ],
  "changelog_dir": "changelog.d",
  "changelog_untagged": ["0.1.0"],
  "docs_targets": [
    "README.md"
  ],
  "labels": {
    "priority": ["priority-high", "priority-medium", "priority-low"],
    "lanes": ["lane-dispatch", "lane-doctor", "lane-prose", "lane-release", "lane-scaffold"],
    "filed_by_loop": "filed-by-loop",
    "lane_other": "lane-other",
    "lane_patterns": {
      "lane-dispatch": [
        "scripts/select_issues*.py",
        "scripts/lane_setup*.py",
        "scripts/ranking_table.py",
        "scripts/tick_handback.py",
        "scripts/review_return.py"
      ],
      "lane-doctor": [
        "scripts/doctor.py",
        "scripts/doctor_check_*.py",
        "scripts/oss-workspace",
        "bin/oss-workspace"
      ],
      "lane-prose": [
        "skills/manager",
        "agents",
        "commands",
        "CLAUDE.md",
        "scripts/skill_phases.py",
        "scripts/agent_budgets.py",
        "scripts/command_budgets.py",
        "scripts/developer_phases.py"
      ],
      "lane-release": [
        "scripts/release_*.py",
        "scripts/assemble_changelog.py",
        "scripts/release_delta.py",
        "scripts/release_publish.py",
        "scripts/release_version.py"
      ],
      "lane-scaffold": [
        "scripts/scaffold.py",
        "scripts/oss_rules.py"
      ]
    }
  },
  "milestones": [],
  "release": {
    "authority": "loop",
    "tag_pattern": "v{version}",
    "merge_method": "squash",
    "commit_subject": null,
    "create_release": true,
    "draft": false,
    "latest": true,
    "triggers": {
      "merged_prs": 10,
      "soak_hours": 48
    }
  }
}
