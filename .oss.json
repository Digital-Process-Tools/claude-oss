{
  "repo": "Digital-Process-Tools/claude-oss",
  "default_branch": "main",
  "branch_pattern": "fix/{issue}",
  "test_command": "pytest",
  "test_measurement_configured": true,
  "version_sites": [
    ".claude-plugin/plugin.json",
    "CHANGELOG.md",
    "README.md",
    "skills/manager/SKILL.md"
  ],
  "changelog_dir": "changelog.d",
  "changelog_untagged": ["0.1.0"],
  "docs_targets": [
    "README.md"
  ],
  "labels": {
    "priority": ["priority-high", "priority-medium", "priority-low"],
    "lanes": [],
    "filed_by_loop": "filed-by-loop"
  },
  "milestones": [],
  "release": {
    "authority": "loop",
    "tag_pattern": "v{version}",
    "merge_method": "squash",
    "commit_subject": null,
    "create_release": true,
    "draft": false,
    "latest": true,
    "triggers": {
      "merged_prs": 10,
      "soak_hours": 48
    }
  }
}
